' Minimal demo: one Activity, one observable state and ONE widget-tree
' expression. The factory UI.* hides Initialize, Dim, SetParent and Render;
' this whole app screen is a single Return/assignment statement.

Sub Process_Globals
    Private CounterState As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private AppTheme As UITheme
    Private Screen As UIScaffold
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If FirstTime Then CounterState = UI.State(0)
    AppTheme = UI.ThemeWithScheme(0xFF6558D3)
    Root.Color = AppTheme.Background
    RebuildUI
End Sub

' Replaces the mounted tree. UI.Show does the SetParent/SetPosition/SetSize/Render
' ceremony; UI.Unmount releases the previous tree before the new one mounts.
Private Sub RebuildUI
    If Screen.IsInitialized Then UI.Unmount(Screen)
    Screen = UI.Scaffold(UI.Center(UI.Column(Null) _
        .Spacing(12dip).MainAxisAlignment("center").CrossAxisAlignment("stretch") _
        .AddChild(UI.Text("You have pushed the button this many times:") _
            .Size(AppTheme.BodyLarge).Color(AppTheme.SecondaryText).ApplyTheme(AppTheme)) _
        .AddChild(UI.Text("").BindText(CounterState) _
            .Size(52).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)))) _
        .AppBar(UI.AppBar("Declarative Counter") _
            .Action(UI.IconFA(Chr(IIf(AppTheme.IsDark, 0xF185, 0xF186))).Size(24) _
                .Color(AppTheme.DashboardBarText).OnClick(Me, "ToggleTheme_Click")) _
            .ApplyTheme(AppTheme)) _
        .FloatingActionButtonRight(UI.Fab("+") _
            .OnClick(Me, "Increment_Click").ApplyTheme(AppTheme)) _
        .ApplyTheme(AppTheme)
    UI.Show(Root, Screen)
End Sub

Sub Increment_Click
    CounterState.SetState(CounterState.GetState + 1)
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    Root.Color = AppTheme.Background
    RebuildUI
End Sub

Sub Activity_Resume
    RebuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub
