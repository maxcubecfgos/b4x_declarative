Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=declarativeui
Library3=okhttputils2
Library4=xui
Library5=javaobject
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~AddPermission(android.permission.INTERNET)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=5
NumberOfModules=0
Version=13.62
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Declarative UI Quickstart
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' Canonical DeclarativeUI example written 100% with the UI.* factory.
' Three screens in one navigable app: Counter, Login and Dashboard.
' No Dim/Initialize/AddView ceremony anywhere - see UI.bas for the API.

Sub Process_Globals
    Private CounterState As UIState
    Private AppTheme As UITheme
End Sub

Sub Globals
    Private Root As B4XView
    Private Nav As UINavigator
    Private Shell As UIScaffold
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private CounterLabel As UILabel
    Private LoginEmail As UIInput
    Private LoginPassword As UIInput
    Private LoginMessage As UILabel
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If FirstTime Then CounterState = UI.State(0)
    AppTheme = UI.ThemeWithScheme(0xFF6750A4)
    Root.Color = AppTheme.Background
    BuildAndMount
End Sub

' Rebuilds the app shell. The whole screen is one expression.
Private Sub BuildAndMount
    If Nav.IsInitialized Then UI.Unmount(Nav)

    Nav = UI.Navigator
    Nav.AddScreen("counter", CounterScreen)
    Nav.AddScreen("login", LoginScreen)
    Nav.AddScreen("dashboard", DashboardScreen)

    Shell = UI.Scaffold(Nav) _
        .AppBar(UI.AppBar("Declarative UI").ApplyTheme(AppTheme)) _
        .BottomNavigationBar(UI.BottomNavigationBar _
            .AddItem("counter", Chr(0xF015), "Contador") _
            .AddItem("login", Chr(0xF007), "Login") _
            .AddItem("dashboard", Chr(0xF0E4), "Panel") _
            .OnSelected(Me, "Nav_Selected").ApplyTheme(AppTheme)) _
        .ApplyTheme(AppTheme)

    UiMounted = False
    LastWidth = 0
    LastHeight = 0
    MountUI
End Sub

Private Sub CounterScreen As Object
    CounterLabel = UI.Text("0").Size(56).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)
    CounterLabel.BindText(CounterState)

    Dim content As UIColumn = UI.Column(Null) _
        .Spacing(16dip).MainAxisAlignment("center").CrossAxisAlignment("center") _
        .AddChild(UI.Text("Contador").Size(18).Color(AppTheme.SecondaryText).ApplyTheme(AppTheme)) _
        .AddChild(CounterLabel) _
        .AddChild(UI.Row(Null).Spacing(16dip) _
            .AddChild(UI.Button("-").CornerRadius(12dip).TextSize(22).OnClick(Me, "Minus_Click").ApplyTheme(AppTheme)) _
            .AddChild(UI.Button("+").CornerRadius(12dip).TextSize(22).OnClick(Me, "Plus_Click").ApplyTheme(AppTheme)))
    Return UI.Center(content).ApplyTheme(AppTheme)
End Sub

Private Sub LoginScreen As Object
    LoginEmail = UI.Input("Email")
    LoginPassword = UI.Input("Contrasena").PasswordMode(True)
    LoginMessage = UI.Text("").Size(14).Color(AppTheme.NegativeText).ApplyTheme(AppTheme)

    Dim fields As UIColumn = UI.Column(Null).Spacing(12dip) _
        .AddChild(UI.Text("Bienvenido").Size(24).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)) _
        .AddChild(UI.Text("Accede a tu cuenta").Size(14).Color(AppTheme.SecondaryText).ApplyTheme(AppTheme)) _
        .AddChild(UI.Space(8dip)) _
        .AddChild(LoginEmail) _
        .AddChild(LoginPassword) _
        .AddChild(LoginMessage) _
        .AddChild(UI.Button("Entrar").CornerRadius(12dip).OnClick(Me, "Login_Click").ApplyTheme(AppTheme))

    Dim card As UICard = UI.Card(fields).ApplyTheme(AppTheme)
    Return UI.Center(UI.Padding(16dip, card)).ApplyTheme(AppTheme)
End Sub

Private Sub DashboardScreen As Object
    Dim statRow As UIRow = UI.Row(Null).Spacing(12dip) _
        .AddChild(StatCard("Ventas", "$1.240", AppTheme.Accent)) _
        .AddChild(StatCard("Usuarios", "3.2k", AppTheme.Info))

    Dim chart As UIColumn = UI.Column(Null).Spacing(10dip) _
        .AddChild(UI.Text("Actividad semanal").Size(16).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)) _
        .AddChild(UI.Progress(45).BarHeight(14dip).CornerRadius(7dip).ApplyTheme(AppTheme)) _
        .AddChild(UI.Progress(72).BarHeight(14dip).CornerRadius(7dip).ApplyTheme(AppTheme)) _
        .AddChild(UI.Progress(30).BarHeight(14dip).CornerRadius(7dip).ApplyTheme(AppTheme))

    Dim content As UIColumn = UI.Column(Null).Spacing(16dip) _
        .AddChild(statRow) _
        .AddChild(UI.Card(chart).ApplyTheme(AppTheme))
    Return UI.Scroll(content)
End Sub

Private Sub StatCard(Title As String, Value As String, Color As Int) As UICard
    Return UI.Card(UI.Column(Null).Spacing(4dip) _
        .AddChild(UI.Text(Title).Size(12).Color(AppTheme.MutedText).ApplyTheme(AppTheme)) _
        .AddChild(UI.Text(Value).Size(22).Color(Color).ApplyTheme(AppTheme)))
End Sub

Private Sub MountUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        UI.Show(Root, Shell)
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
    End If
    Nav.RefreshInsets
End Sub

Sub Nav_Selected(Index As Int, Id As String)
    Nav.NavigateTo(Id)
End Sub

Sub Plus_Click
    CounterState.SetState(GetCounter + 1)
End Sub

Sub Minus_Click
    CounterState.SetState(Max(0, GetCounter - 1))
End Sub

Private Sub GetCounter As Int
    Return CounterState.GetState
End Sub

Sub Login_Click
    If LoginEmail.GetText.Trim.Length = 0 Then
        LoginMessage.Text("Escribe tu email.")
    Else
        LoginMessage.Text("Bienvenido, " & LoginEmail.GetText & "!")
    End If
End Sub

Sub Activity_Resume
    MountUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub
