Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=ime
Library3=xui
Library4=declarativeui
Library5=okhttputils2
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~AddPermission(android.permission.INTERNET)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=5
NumberOfModules=0
Version=13.62
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: NOVA UI Lab
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' NOVA UI Lab is intentionally small: one Activity, three declarative screens.
' It is an offline showcase so the first run does not depend on network access.

Sub Process_Globals
    Private NavigationState As UIState
    Private CounterState As UIState
    Private CounterTextState As UIState
    Private NameState As UIState
    Private GreetingState As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private AppTheme As UITheme
    Private Snack As UISnackBar
    Private HeroCard As UICard
    Private HeroAnimation As UIAnimation
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private ActiveScreen As String
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If NavigationState.IsInitialized = False Then NavigationState.Initialize(0)
    If CounterState.IsInitialized = False Then CounterState.Initialize(0)
    If CounterTextState.IsInitialized = False Then CounterTextState.Initialize("00")
    If NameState.IsInitialized = False Then NameState.Initialize("")
    If GreetingState.IsInitialized = False Then GreetingState.Initialize("Type a name to update this message.")
    ActiveScreen = "Home"

    AppTheme.Initialize.Scheme(0xFF6558D3)
    Root.Color = AppTheme.Background
    Snack.Initialize.ApplyTheme(AppTheme).CornerRadius(AppTheme.SnackbarRadius)
    RebuildScreens
End Sub

' Recreates only the virtual screen tree. The native Activity remains untouched.
Private Sub RebuildScreens
    If Navigator <> Null Then
        If Navigator.IsInitialized Then Navigator.Unmount
    End If
    Navigator.Initialize
    Navigator.AddScreen("Home", BuildHome)
    Navigator.AddScreen("Components", BuildComponents)
    Navigator.AddScreen("Playground", BuildPlayground)
    UiMounted = False
    LastWidth = 0
    LastHeight = 0
    BuildUI
End Sub

' ============================================================================
' Screens
' ============================================================================

Private Sub BuildHome As UIScaffold
    Dim eyebrow As UILabel = TextLabel("DECLARATIVE UI FOR B4A", 12, AppTheme.Accent)
    Dim heading As UILabel = TextLabel("Build interfaces\nthat feel alive.", 30, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("A compact, Flutter-inspired layer for composing native Android screens with readable B4A code.", 15, AppTheme.SecondaryText)

    Dim titleBlock As UIColumn
    titleBlock.Initialize.Spacing(7dip).AddChild(eyebrow).AddChild(heading).AddChild(intro)

    Dim placeholder As UIPlaceholder
    placeholder.Initialize.FallbackSize(260dip, 150dip).Color(AppTheme.Accent).StrokeWidth(2dip) _
        .ApplyTheme(AppTheme)
    Dim visualCard As UICard
    visualCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.RadiusLarge).Child(BuildPadding(placeholder, 14dip)).ApplyTheme(AppTheme)

    Dim badge As UICard
    badge.Initialize.BackgroundColor(AppTheme.Accent).CornerRadius(AppTheme.RadiusSmall) _
        .Child(BuildPadding(TextLabel("ONE ACTIVITY · THREE SCREENS", 11, AppTheme.AccentText), 8dip))
    Dim heroStack As UIStack
    heroStack.Initialize.Alignment("topRight").AddChild(visualCard).AddChild(badge)

    HeroCard.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.RadiusLarge).Child(BuildPadding(BuildColumn2(titleBlock, heroStack), 16dip)) _
        .ApplyTheme(AppTheme)

    Dim explore As UIButton
    explore.Initialize.Text("EXPLORE COMPONENTS").BackgroundColor(AppTheme.Accent) _
        .TextColor(AppTheme.AccentText).CornerRadius(AppTheme.ButtonRadius) _
        .OnClick(Me, "OpenComponents_Click")
    Dim tryIt As UIButton
    tryIt.Initialize.Text("TRY THE PLAYGROUND").BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(AppTheme.ButtonRadius) _
        .OnClick(Me, "OpenPlayground_Click")
    Dim actions As UIRow
    actions.Initialize.Spacing(10dip).CrossAxisAlignment("center").AddChild(explore).AddChild(tryIt)

    Dim stateCard As UICard = FeatureCard("State-driven", "Change a value and let the bound widgets update themselves.", Chr(61664), AppTheme.Info)
    Dim layoutCard As UICard = FeatureCard("Measured layout", "Column, Row, Center, Stack and Card compose naturally without manual coordinates.", Chr(61695), AppTheme.Accent)
    Dim polishCard As UICard = FeatureCard("Native polish", "Themes, rounded controls, navigation, snackbars and animations stay close to native Android.", Chr(61473), AppTheme.Negative)

    Dim features As UIColumn
    features.Initialize.Spacing(10dip).AddChild(stateCard).AddChild(layoutCard).AddChild(polishCard)

    Dim content As UIColumn
    content.Initialize.Spacing(14dip).AddChild(HeroCard).AddChild(actions) _
        .AddChild(TextLabel("WHY THIS APPROACH", 12, AppTheme.MutedText)).AddChild(features)
    Return Screen("NOVA UI LAB", content)
End Sub

Private Sub BuildComponents As UIScaffold
    Dim title As UILabel = TextLabel("A small design system,\ncomposed in code.", 27, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("The same theme flows through every component. Explicit overrides are still available when a screen needs a distinct accent.", 15, AppTheme.SecondaryText)

    Dim palette As UICard
    palette.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.RadiusLarge).Child(BuildPadding(BuildPalette, 14dip)).ApplyTheme(AppTheme)

    Dim placeholder As UIPlaceholder
    placeholder.Initialize.FallbackSize(320dip, 90dip).StrokeWidth(2dip).Color(AppTheme.Info) _
        .ApplyTheme(AppTheme)
    Dim placeholderCard As UICard
    placeholderCard.Initialize.CornerRadius(AppTheme.CardRadius).BorderColor(AppTheme.Info) _
        .Child(BuildPadding(BuildColumn3(TextLabel("Flutter-like Placeholder", 16, AppTheme.PrimaryText), _
        TextLabel("A visual layout marker, useful while designing a screen.", 14, AppTheme.SecondaryText), placeholder), 14dip)) _
        .ApplyTheme(AppTheme)

    Dim divider As UIDivider
    divider.Initialize.ApplyTheme(AppTheme)
    Dim button As UIButton
    button.Initialize.Text("SHOW SNACKBAR").BackgroundColor(AppTheme.Accent) _
        .TextColor(AppTheme.AccentText).CornerRadius(AppTheme.ButtonRadius) _
        .OnClick(Me, "ShowComponentsSnack_Click")
    Dim buttonCard As UICard
    buttonCard.Initialize.CornerRadius(AppTheme.CardRadius)        .Child(BuildPadding(BuildColumn3( _
        TextLabel("Interactive controls", 16, AppTheme.PrimaryText), button, divider), 14dip)).ApplyTheme(AppTheme)

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(intro).AddChild(palette) _
        .AddChild(placeholderCard).AddChild(buttonCard)
    Return Screen("COMPONENTS", content)
End Sub

Private Sub BuildPlayground As UIScaffold
    Dim title As UILabel = TextLabel("A living screen,\nnot a static mockup.", 27, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("UIState keeps the counter and the input synchronized while the same Activity handles navigation and feedback.", 15, AppTheme.SecondaryText)

    Dim counterText As UILabel
    counterText.Initialize.BindText(CounterTextState).Size(52).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)
    Dim counterCaption As UILabel = TextLabel("CURRENT VALUE", 11, AppTheme.MutedText)
    Dim minus As UIButton
    minus.Initialize.Text("−").BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .CornerRadius(AppTheme.RadiusMedium).OnClick(Me, "Decrement_Click")
    Dim plus As UIButton
    plus.Initialize.Text("+").BackgroundColor(AppTheme.Accent).TextColor(AppTheme.AccentText) _
        .CornerRadius(AppTheme.RadiusMedium).OnClick(Me, "Increment_Click")
    Dim counterActions As UIRow
    counterActions.Initialize.Spacing(10dip).MainAxisAlignment("center").AddChild(minus).AddChild(plus)
    Dim counterCard As UICard
    counterCard.Initialize.BackgroundColor(AppTheme.HeroSurface).CornerRadius(AppTheme.RadiusLarge) _
        .Child(BuildPadding(BuildColumn3(counterCaption, counterText, counterActions), 16dip)).ApplyTheme(AppTheme)

    Dim nameInput As UIInput
    nameInput.Initialize.Hint("Your name").BindText(NameState).OnTextChanged(Me, "Name_Changed") _
        .CornerRadius(AppTheme.InputRadius).Border(AppTheme.BorderWidth, AppTheme.Border).ApplyTheme(AppTheme)
    Dim greeting As UILabel
    greeting.Initialize.BindText(GreetingState).Size(16).ApplyTheme(AppTheme).Color(AppTheme.PrimaryText)
    Dim greetButton As UIButton
    greetButton.Initialize.Text("SAY HELLO").BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(AppTheme.ButtonRadius).OnClick(Me, "Greeting_Click")
    Dim inputCard As UICard
    inputCard.Initialize.CornerRadius(AppTheme.CardRadius)        .Child(BuildPadding(BuildColumn4( _
        TextLabel("Bound input", 16, AppTheme.PrimaryText), nameInput, greeting, greetButton), 14dip)) _
        .ApplyTheme(AppTheme)

    Dim themeButton As UIButton
    themeButton.Initialize.Text(ThemeButtonText).BackgroundColor(AppTheme.ThemeAction) _
        .TextColor(AppTheme.ThemeActionText).CornerRadius(AppTheme.ButtonRadius) _
        .OnClick(Me, "ToggleTheme_Click")
    Dim note As UILabel = TextLabel("Toggle the theme to rebuild the same declarative tree with a new palette.", 13, AppTheme.SecondaryText)
    Dim themeCard As UICard
    themeCard.Initialize.BorderColor(AppTheme.Border).CornerRadius(AppTheme.CardRadius) _
        .Child(BuildPadding(BuildColumn2(themeButton, note), 14dip)).ApplyTheme(AppTheme)

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(intro).AddChild(counterCard) _
        .AddChild(inputCard).AddChild(themeCard)
    Return Screen("PLAYGROUND", content)
End Sub

' ============================================================================
' Reusable declarative builders
' ============================================================================

Private Sub Screen(Title As String, Content As Object) As UIScaffold
    Dim scroll As UIScrollView
    scroll.Initialize.Child(BuildPadding(Content, 16dip)).ApplyTheme(AppTheme)
    Dim result As UIScaffold
    result.Initialize.AppBar(BuildBar(Title)).Body(scroll).BottomNavigationBar(BuildNavigation) _
        .ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildBar(Title As String) As UIAppBar
    Dim result As UIAppBar
    result.Initialize.Title(Title).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildNavigation As UIBottomNavigationBar
    Dim result As UIBottomNavigationBar
    result.Initialize.AddItem("Home", Chr(61461), "Home").AddItem("Components", Chr(61502), "Components") _
        .AddItem("Playground", Chr(61452), "Playground").BindSelectedIndex(NavigationState) _
        .OnSelected(Me, "Navigation_Changed").UseFontAwesome(True).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildPadding(Child As Object, Amount As Int) As UIPadding
    Dim result As UIPadding
    result.Initialize.All(Amount).Child(Child)
    Return result
End Sub

Private Sub BuildColumn2(First As Object, Second As Object) As UIColumn
    Dim result As UIColumn
    result.Initialize.Spacing(7dip).AddChild(First).AddChild(Second)
    Return result
End Sub

Private Sub BuildColumn3(First As Object, Second As Object, Third As Object) As UIColumn
    Dim result As UIColumn
    result.Initialize.Spacing(7dip).AddChild(First).AddChild(Second).AddChild(Third)
    Return result
End Sub

Private Sub BuildColumn4(First As Object, Second As Object, Third As Object, Fourth As Object) As UIColumn
    Dim result As UIColumn
    result.Initialize.Spacing(7dip).AddChild(First).AddChild(Second).AddChild(Third).AddChild(Fourth)
    Return result
End Sub

Private Sub TextLabel(Value As String, Size As Int, Color As Int) As UILabel
    Dim result As UILabel
    result.Initialize.Text(Value).Size(Size).ApplyTheme(AppTheme).Color(Color)
    Return result
End Sub

Private Sub FeatureCard(Title As String, Description As String, Icon As String, Accent As Int) As UICard
    Dim iconLabel As UILabel = TextLabel(Icon, 22, Accent)
    Dim body As UIColumn
    body.Initialize.Spacing(3dip).AddChild(iconLabel).AddChild(TextLabel(Title, 16, AppTheme.PrimaryText)) _
        .AddChild(TextLabel(Description, 14, AppTheme.SecondaryText))
    Dim result As UICard
    result.Initialize.BorderColor(Accent).CornerRadius(AppTheme.CardRadius) _
        .Child(BuildPadding(body, 13dip)).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildPalette As UIColumn
    Dim row As UIRow
    row.Initialize.Spacing(8dip).AddChild(ColorSwatch(AppTheme.Accent, "Primary", AppTheme.AccentText)) _
        .AddChild(ColorSwatch(AppTheme.Info, "Info", AppTheme.InfoText)).AddChild(ColorSwatch(AppTheme.Negative, "Action", AppTheme.NegativeText))
    Dim result As UIColumn
    result.Initialize.Spacing(8dip).AddChild(TextLabel("Theme tokens", 16, AppTheme.PrimaryText)) _
        .AddChild(TextLabel("One seed color generates a consistent visual language.", 14, AppTheme.SecondaryText)) _
        .AddChild(row)
    Return result
End Sub

Private Sub ColorSwatch(Color As Int, Caption As String, Foreground As Int) As UICard
    Dim sample As UICard
    sample.Initialize.BackgroundColor(Color).CornerRadius(AppTheme.RadiusSmall) _
        .Child(BuildPadding(TextLabel(Caption, 12, Foreground), 8dip))
    Return sample
End Sub

Private Sub ThemeButtonText As String
    If AppTheme.IsDark Then Return "USE LIGHT THEME"
    Return "USE DARK THEME"
End Sub

Private Sub GreetingText As String
    Dim name As String = "" & NameState.GetState
    If name.Trim = "" Then Return "Type a name to update this message."
    Return "Hello, " & name & "!"
End Sub

' ============================================================================
' Mounting, navigation and interaction
' ============================================================================

Private Sub BuildUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
        If ActiveScreen = "Home" Then AnimateHero
    End If
    Navigator.RefreshInsets
End Sub

Sub Navigation_Changed(Index As Int, Id As String)
    NavigationState.SetState(Index)
    ActiveScreen = Id
    Navigator.NavigateTo(Id)
End Sub

Sub OpenComponents_Click
    NavigationState.SetState(1)
    ActiveScreen = "Components"
    Navigator.NavigateTo("Components")
End Sub

Sub OpenPlayground_Click
    NavigationState.SetState(2)
    ActiveScreen = "Playground"
    Navigator.NavigateTo("Playground")
End Sub

Sub Increment_Click
    Dim value As Int = CounterState.GetState
    CounterState.SetState(value + 1)
    CounterTextState.SetState(NumberFormat2(value + 1, 2, 0, 0, False))
End Sub

Sub Decrement_Click
    Dim value As Int = CounterState.GetState
    CounterState.SetState(Max(0, value - 1))
    CounterTextState.SetState(NumberFormat2(Max(0, value - 1), 2, 0, 0, False))
End Sub

Sub Name_Changed(NewText As String)
    NameState.SetState(NewText)
    If NewText.Trim = "" Then
        GreetingState.SetState("Type a name to update this message.")
    Else
        GreetingState.SetState("Hello, " & NewText & "!")
    End If
End Sub

Sub Greeting_Click
    Snack.Message(GreetingText).Action("OK", Me, "CloseSnack_Click").Show(Root)
End Sub

Sub ShowComponentsSnack_Click
    Snack.Message("Every surface is declared in B4A.").Action("OK", Me, "CloseSnack_Click").Show(Root)
End Sub

Sub CloseSnack_Click
    Snack.Dismiss
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    Root.Color = AppTheme.Background
    RebuildScreens
End Sub

Private Sub AnimateHero
    If HeroCard = Null Then Return
    Dim cardView As B4XView = HeroCard.GetView
    If cardView = Null Or cardView.IsInitialized = False Then Return
    HeroAnimation.Initialize.TargetView(cardView).MoveTo(cardView.Left, cardView.Top - 6dip) _
        .Duration(180).OnCompleted(Me, "HeroAnimationBack").Start
End Sub

Sub HeroAnimationBack 'ignore
    If HeroCard = Null Then Return
    Dim cardView As B4XView = HeroCard.GetView
    If cardView = Null Or cardView.IsInitialized = False Then Return
    HeroAnimation.Initialize.TargetView(cardView).MoveTo(cardView.Left, cardView.Top + 6dip) _
        .Duration(220).Start
End Sub

Sub Activity_Resume
    BuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

' The demo intentionally keeps the usage visible:
' - screen builders describe the UI tree;
' - UIState updates bound widgets;
' - UIScrollView handles measured content;
' - UIAnimation adds one opt-in transition;
' - UIPlaceholder demonstrates a Flutter-like design marker;
' - UISnackBar provides transient feedback without another Activity.
