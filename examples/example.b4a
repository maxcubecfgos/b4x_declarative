Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=ime
Library3=xui
Library4=declarativeui
Library5=okhttputils2
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~AddPermission(android.permission.INTERNET)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=5
NumberOfModules=0
Version=13.62
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Declarative Counter
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' A small, practical example of declarative UI for B4A.
' It uses one Activity, two screens and explicit buttons instead of a bottom bar.

Sub Process_Globals
    Private CounterState As UIState
    Private AdvancedCounterState As UIState
    Private StepState As UIState
    Private ProgressState As UIState
    Private ImcResultState As UIState
    Private ImcHistoryState As UIState
    Private ImcHistoryList As List
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private AppTheme As UITheme
    Private Snack As UISnackBar
    Private ActiveScreen As String
    Private ActiveCard As UICard
    Private CardAnimation As UIAnimation
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private WeightInput As UIInput
    Private HeightInput As UIInput
    Private ImcResultLabel As UILabel
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If CounterState.IsInitialized = False Then CounterState.Initialize(0)
    If AdvancedCounterState.IsInitialized = False Then AdvancedCounterState.Initialize(0)
    If StepState.IsInitialized = False Then StepState.Initialize(1)
    If ProgressState.IsInitialized = False Then ProgressState.Initialize(0)
    If ImcResultState.IsInitialized = False Then ImcResultState.Initialize("Enter your values and press CALCULATE")
    If ImcHistoryState.IsInitialized = False Then ImcHistoryState.Initialize("No calculations yet.")
    If ImcHistoryList.IsInitialized = False Then ImcHistoryList.Initialize

    ActiveScreen = "Simple"
    AppTheme.Initialize.Scheme(0xFF6558D3)
    Snack.Initialize.ApplyTheme(AppTheme)
    RebuildScreens
End Sub

' Rebuilds the declarative tree while preserving the current route.
Private Sub RebuildScreens
    Dim route As String = ActiveScreen
    If route.Trim = "" Then route = "Simple"

    If Navigator <> Null Then
        If Navigator.IsInitialized Then Navigator.Unmount
    End If

    Navigator.Initialize
    Navigator.AddScreen("Simple", BuildSimpleScreen)
    Navigator.AddScreen("Advanced", BuildAdvancedScreen)
    Navigator.AddScreen("Imc", BuildImcScreen)
    If route <> "Simple" Then Navigator.NavigateTo(route)

    UiMounted = False
    LastWidth = 0
    LastHeight = 0
    BuildUI
End Sub

' ============================================================================
' Screens
' ============================================================================

Private Sub BuildSimpleScreen As UIScaffold
    Dim counterBody As UIColumn
    counterBody.Initialize.Spacing(16dip).MainAxisAlignment("center") _
        .CrossAxisAlignment("center") _
        .AddChild(LabelText("You have pushed the button this many times:", AppTheme.BodyLarge, AppTheme.SecondaryText)) _
        .AddChild(ValueLabel(CounterState, 48))

    Dim counterCard As UICard
    counterCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.RadiusLarge).Child(Pad(counterBody, 24dip)).ApplyTheme(AppTheme)
    ActiveCard = counterCard

    Dim bmi As UIButton
    bmi.Initialize.Text("BMI CALCULATOR").CornerRadius(AppTheme.ButtonRadius) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "OpenImc_Click")

    Dim content As UIColumn
    content.Initialize.Spacing(14dip).MainAxisAlignment("center") _
        .AddChild(counterCard).AddChild(bmi)

    Dim fab As UIFloatingActionButton
    fab.Initialize.Text("+").OnClick(Me, "SimpleIncrement_Click").ApplyTheme(AppTheme)

    Dim result As UIScaffold = ScreenWithAction("DECLARATIVE COUNTER", content, True)
    result.FloatingActionButtonRight(fab)
    Return result
End Sub

Private Sub BuildAdvancedScreen As UIScaffold
    Dim title As UILabel = LabelText("Advanced counter", AppTheme.HeadlineSmall, AppTheme.PrimaryText)
    Dim description As UILabel = LabelText("The same declarative model can coordinate several states, controls and visual feedback without manual view updates.", AppTheme.BodyMedium, AppTheme.SecondaryText)

    Dim value As UILabel
    value.Initialize.BindText(AdvancedCounterState).Size(56).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)

    Dim minus As UIButton
    minus.Initialize.Text("−").CornerRadius(AppTheme.RadiusMedium) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "AdvancedDecrement_Click")
    Dim plus As UIButton
    plus.Initialize.Text("+").CornerRadius(AppTheme.RadiusMedium) _
        .BackgroundColor(AppTheme.Accent).TextColor(AppTheme.AccentText) _
        .OnClick(Me, "AdvancedIncrement_Click")
    Dim counterButtons As UIRow
    counterButtons.Initialize.Spacing(12dip).MainAxisAlignment("center") _
        .AddChild(minus).AddChild(plus)

    Dim counterBody As UIColumn
    counterBody.Initialize.Spacing(10dip).MainAxisAlignment("center") _
        .CrossAxisAlignment("center").AddChild(LabelText("ADVANCED VALUE", AppTheme.LabelMedium, AppTheme.MutedText)) _
        .AddChild(value).AddChild(counterButtons)
    Dim counterCard As UICard
    counterCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.RadiusLarge).Child(Pad(counterBody, 18dip)).ApplyTheme(AppTheme)
    ActiveCard = counterCard

    Dim stepLabel As UILabel
    stepLabel.Initialize.BindText(StepState).Size(AppTheme.BodyLarge).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)
    Dim stepTitle As UILabel = LabelText("STEP", AppTheme.LabelMedium, AppTheme.MutedText)
    Dim smaller As UIButton
    smaller.Initialize.Text("−").CornerRadius(AppTheme.RadiusSmall) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "StepDown_Click")
    Dim larger As UIButton
    larger.Initialize.Text("+").CornerRadius(AppTheme.RadiusSmall) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "StepUp_Click")
    Dim stepRow As UIRow
    stepRow.Initialize.Spacing(8dip).CrossAxisAlignment("center") _
        .AddChild(stepTitle).AddChild(stepLabel).AddChild(smaller).AddChild(larger)

    Dim progress As UIProgressBar
    progress.Initialize.BindValue(ProgressState).BarHeight(8dip).ApplyTheme(AppTheme)
    Dim progressLabel As UILabel = LabelText("PROGRESS · 0–100", AppTheme.LabelMedium, AppTheme.MutedText)
    Dim details As UIColumn
    details.Initialize.Spacing(8dip).AddChild(stepRow).AddChild(progressLabel).AddChild(progress)
    Dim detailsCard As UICard
    detailsCard.Initialize.BorderColor(AppTheme.Border).CornerRadius(AppTheme.CardRadius) _
        .Child(Pad(details, 14dip)).ApplyTheme(AppTheme)

    Dim reset As UIButton
    reset.Initialize.Text("RESET").CornerRadius(AppTheme.ButtonRadius) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "ResetAdvanced_Click")
    Dim back As UIButton
    back.Initialize.Text("BACK TO SIMPLE").CornerRadius(AppTheme.ButtonRadius) _
        .BackgroundColor(AppTheme.Accent).TextColor(AppTheme.AccentText) _
        .OnClick(Me, "BackToSimple_Click")
    Dim actions As UIRow
    actions.Initialize.Spacing(8dip).CrossAxisAlignment("center") _
        .AddChild(reset).AddChild(back)

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(description) _
        .AddChild(counterCard).AddChild(detailsCard).AddChild(actions)
    Return Screen("ADVANCED COUNTER", content)
End Sub

Private Sub BuildImcScreen As UIScaffold
    Dim title As UILabel = LabelText("Body mass index", AppTheme.HeadlineSmall, AppTheme.PrimaryText)
    Dim description As UILabel = LabelText("Enter your weight and height to calculate your body mass index.", AppTheme.BodyMedium, AppTheme.SecondaryText)

    Dim weightLabel As UILabel = LabelText("WEIGHT (KG)", AppTheme.LabelMedium, AppTheme.MutedText)
    WeightInput.Initialize.Hint("e.g. 72").ApplyTheme(AppTheme)
    Dim heightLabel As UILabel = LabelText("HEIGHT (CM)", AppTheme.LabelMedium, AppTheme.MutedText)
    HeightInput.Initialize.Hint("e.g. 175").ApplyTheme(AppTheme)

    Dim form As UIColumn
    form.Initialize.Spacing(8dip).AddChild(weightLabel).AddChild(WeightInput) _
        .AddChild(heightLabel).AddChild(HeightInput)
    Dim formCard As UICard
    formCard.Initialize.BorderColor(AppTheme.Border).CornerRadius(AppTheme.CardRadius) _
        .Child(Pad(form, 14dip)).ApplyTheme(AppTheme)

    Dim calculate As UIButton
    calculate.Initialize.Text("CALCULATE").CornerRadius(AppTheme.ButtonRadius) _
        .BackgroundColor(AppTheme.Accent).TextColor(AppTheme.AccentText) _
        .OnClick(Me, "CalculateImc_Click")

    ImcResultLabel.Initialize.BindText(ImcResultState).Size(AppTheme.TitleLarge) _
        .Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)
    Dim resultCard As UICard
    resultCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(AppTheme.CardRadius).Child(Pad(ImcResultLabel, 16dip)).ApplyTheme(AppTheme)

    Dim historyTitle As UILabel = LabelText("HISTORY", AppTheme.LabelMedium, AppTheme.MutedText)
    Dim history As UILabel
    history.Initialize.BindText(ImcHistoryState).Size(AppTheme.BodySmall) _
        .Color(AppTheme.SecondaryText).ApplyTheme(AppTheme)
    Dim historyCard As UICard
    historyCard.Initialize.BorderColor(AppTheme.Border).CornerRadius(AppTheme.CardRadius) _
        .Child(Pad(history, 14dip)).ApplyTheme(AppTheme)

    Dim back As UIButton
    back.Initialize.Text("BACK TO SIMPLE").CornerRadius(AppTheme.ButtonRadius) _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.ButtonText) _
        .OnClick(Me, "BackToSimple_Click")

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(description) _
        .AddChild(formCard).AddChild(calculate).AddChild(resultCard) _
        .AddChild(historyTitle).AddChild(historyCard).AddChild(back)
    Return Screen("BMI CALCULATOR", content)
End Sub

' ============================================================================
' Declarative builders
' ============================================================================

Private Sub Screen(Title As String, Content As Object) As UIScaffold
    Return ScreenWithAction(Title, Content, False)
End Sub

Private Sub ScreenWithAction(Title As String, Content As Object, ShowThemeAction As Boolean) As UIScaffold
    Dim scroll As UIScrollView
    scroll.Initialize.Child(Pad(Content, 16dip)).ApplyTheme(AppTheme)
    Dim result As UIScaffold
    result.Initialize.AppBar(BuildBar(Title, ShowThemeAction)).Body(scroll).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildBar(Title As String, ShowThemeAction As Boolean) As UIAppBar
    Dim result As UIAppBar
    result.Initialize.Title(Title).ApplyTheme(AppTheme)
    If ShowThemeAction Then
        Dim icon As UIIcon
        icon.Initialize.MaterialCode(ThemeIconCode).Size(24) _
            .Color(AppTheme.DashboardBarText).OnClick(Me, "ToggleTheme_Click")
        result.Action(icon)
    End If
    Return result
End Sub

Private Sub ThemeIconCode As Int
    If AppTheme.IsDark Then Return 58648 ' light_mode
    Return 58652 ' dark_mode
End Sub

Private Sub Pad(Child As Object, Amount As Int) As UIPadding
    Dim result As UIPadding
    result.Initialize.All(Amount).Child(Child)
    Return result
End Sub

Private Sub LabelText(Value As String, Size As Int, Color As Int) As UILabel
    Dim result As UILabel
    result.Initialize.Text(Value).Size(Size).Color(Color).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub ValueLabel(State As UIState, Size As Int) As UILabel
    Dim result As UILabel
    result.Initialize.BindText(State).Size(Size).Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)
    Return result
End Sub

' ============================================================================
' Mounting and navigation
' ============================================================================

Private Sub BuildUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
        AnimateCard
    End If
    Navigator.RefreshInsets
End Sub

Sub OpenAdvanced_Click
    ActiveScreen = "Advanced"
    Navigator.NavigateTo(ActiveScreen)
    AnimateCard
End Sub

Sub OpenImc_Click
    ActiveScreen = "Imc"
    Navigator.NavigateTo(ActiveScreen)
End Sub

Sub BackToSimple_Click
    ActiveScreen = "Simple"
    Navigator.NavigateTo(ActiveScreen)
End Sub

' ============================================================================
' BMI calculator
' ============================================================================

Sub CalculateImc_Click
    Dim weightText As String = WeightInput.GetText.Trim
    Dim heightText As String = HeightInput.GetText.Trim
    If IsNumericText(weightText) = False Or IsNumericText(heightText) = False Then
        Snack.Message("Enter a valid weight and height").Duration(1500).Show(Root)
        Return
    End If
    Dim weight As Double = weightText
    Dim height As Double = heightText
    If weight <= 0 Or height <= 0 Then
        Snack.Message("Weight and height must be greater than zero").Duration(1500).Show(Root)
        Return
    End If

    Dim heightMeters As Double = height / 100
    Dim imc As Double = weight / (heightMeters * heightMeters)
    Dim imcText As String = NumberFormat(imc, 1, 1)
    Dim category As String
    Dim categoryColor As Int
    Select Case True
        Case imc < 18.5
            category = "Underweight"
            categoryColor = AppTheme.Info
        Case imc < 25
            category = "Normal"
            categoryColor = 0xFF2E7D32
        Case imc < 30
            category = "Overweight"
            categoryColor = 0xFFF57C00
        Case Else
            category = "Obese"
            categoryColor = AppTheme.Negative
    End Select

    ImcResultState.SetState(imcText & " · " & category)
    If ImcResultLabel <> Null Then
        If ImcResultLabel.IsInitialized Then ImcResultLabel.Color(categoryColor)
    End If

    ImcHistoryList.InsertAt(0, weightText & " kg / " & heightText & " cm → " & imcText & " · " & category)
    Do While ImcHistoryList.Size > 5
        ImcHistoryList.RemoveAt(ImcHistoryList.Size - 1)
    Loop
    ImcHistoryState.SetState(JoinHistory)
End Sub

Private Sub JoinHistory As String
    Dim sb As StringBuilder
    sb.Initialize
    For i = 0 To ImcHistoryList.Size - 1
        If i > 0 Then sb.Append(CRLF)
        sb.Append(i + 1).Append(". ").Append(ImcHistoryList.Get(i))
    Next
    Return sb.ToString
End Sub

Private Sub IsNumericText(Text As String) As Boolean
    If Text = "" Then Return False
    Dim dotFound As Boolean = False
    For i = 0 To Text.Length - 1
        Dim code As Int = Asc(Text.CharAt(i))
        If code = 46 Then ' '.'
            If dotFound Then Return False
            dotFound = True
        Else If code < 48 Or code > 57 Then ' digits 0-9
            Return False
        End If
    Next
    Return True
End Sub

' ============================================================================
' State and interaction
' ============================================================================

Sub SimpleIncrement_Click
    CounterState.SetState(CounterState.GetState + 1)
End Sub

Sub SimpleDecrement_Click
    CounterState.SetState(Max(0, CounterState.GetState - 1))
End Sub

Sub AdvancedIncrement_Click
    SetAdvancedValue(AdvancedCounterState.GetState + StepState.GetState)
    Snack.Message("Advanced counter updated").Duration(1200).Show(Root)
End Sub

Sub AdvancedDecrement_Click
    SetAdvancedValue(Max(0, AdvancedCounterState.GetState - StepState.GetState))
End Sub

Sub StepDown_Click
    StepState.SetState(Max(1, StepState.GetState - 1))
End Sub

Sub StepUp_Click
    StepState.SetState(Min(10, StepState.GetState + 1))
End Sub

Sub ResetAdvanced_Click
    AdvancedCounterState.SetState(0)
    ProgressState.SetState(0)
    StepState.SetState(1)
    Snack.Message("Advanced counter reset").Duration(1200).Show(Root)
End Sub

Private Sub SetAdvancedValue(Value As Int)
    Dim safeValue As Int = Max(0, Value)
    AdvancedCounterState.SetState(safeValue)
    ProgressState.SetState(Min(100, safeValue))
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    Root.Color = AppTheme.Background
    Snack.ApplyTheme(AppTheme)
    RebuildScreens
End Sub

Private Sub AnimateCard
    If ActiveCard = Null Then Return
    Dim view As B4XView = ActiveCard.GetView
    If view = Null Or view.IsInitialized = False Then Return
    CardAnimation.Initialize.TargetView(view).MoveTo(view.Left, view.Top - 4dip) _
        .Duration(160).OnCompleted(Me, "ReturnCard_Click").Start
End Sub

Sub ReturnCard_Click
    If ActiveCard = Null Then Return
    Dim view As B4XView = ActiveCard.GetView
    If view = Null Or view.IsInitialized = False Then Return
    CardAnimation.Initialize.TargetView(view).MoveTo(view.Left, view.Top + 4dip).Duration(180).Start
End Sub

Sub Activity_Resume
    BuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

' This example intentionally demonstrates:
' - declarative screen builders;
' - UIState bindings instead of manual label updates;
' - measured Column, Row, Card, Padding and ScrollView layout;
' - a state-bound progress bar;
' - a snackbar and a small opt-in animation;
' - explicit navigation without a bottom navigation bar.
