@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Canary Journal
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' Canary Journal is a small educational app built in one Activity.
' The screen builders describe the result; the library mounts the native views.

Sub Process_Globals
    Private NavigationState As UIState
    Private ImageStatusState As UIState
    Private TipsVisibleState As UIState
    Private NameState As UIState
    Private ImageAsyncState As UIAsyncState
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private AppTheme As UITheme
    Private Snack As UISnackBar
    Private HeroCard As UICard
    Private VarietyCards As List
    Private HeroImage As ImageView
    Private VarietyImages As List
    Private YellowBitmap, RedBitmap, WhiteBitmap As Bitmap
    Private FallbackBitmap As Bitmap
    Private HeroAnimation As UIAnimation
    Private ActiveRoute As String
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private ImagesStarted As Boolean
    Private YellowUrl As String
    Private RedUrl As String
    Private WhiteUrl As String
    Private Const ImageUserAgent As String = "CanaryJournal/1.0 (educational B4A demo)"
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If NavigationState.IsInitialized = False Then NavigationState.Initialize(0)
    If ImageStatusState.IsInitialized = False Then ImageStatusState.Initialize("Preparing the aviary...")
    If TipsVisibleState.IsInitialized = False Then TipsVisibleState.Initialize(True)
    If NameState.IsInitialized = False Then NameState.Initialize("")
    If ImageAsyncState.IsInitialized = False Then ImageAsyncState.Initialize
    ImageAsyncState.Subscribe(Me, "ImageAsyncState_Changed")

    YellowUrl = "https://upload.wikimedia.org/wikipedia/commons/e/ec/A_yellow_domestic_canary_on_a_stick.jpg"
    RedUrl = "https://upload.wikimedia.org/wikipedia/commons/e/ea/Serinus_canaria_Rosso_Intenso.jpg"
    WhiteUrl = "https://upload.wikimedia.org/wikipedia/commons/3/36/White_canary.jpg"

    AppTheme.Initialize.Scheme(0xFFD98B2B)
    FallbackBitmap = CreateFallbackCanary
    Root.Color = AppTheme.Background
    Snack.Initialize.ApplyTheme(AppTheme).CornerRadius(14dip)
    ActiveRoute = "Canaries"

    Navigator.Initialize
    Navigator.AddScreen("Canaries", BuildCanaries)
    Navigator.AddScreen("Varieties", BuildVarieties)
    Navigator.AddScreen("Care", BuildCare)
    BuildUI
End Sub

' ============================================================================
' Screens
' ============================================================================

Private Sub BuildCanaries As UIScaffold
    HeroImage = Null
    Dim title As UILabel = TextLabel("CANARY JOURNAL", 12, AppTheme.Accent)
    Dim heading As UILabel = TextLabel("A tiny guide to bright voices.", 28, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("Learn the main varieties, colors and daily habits of a domestic canary.", 15, AppTheme.SecondaryText)
    Dim imageStatus As UILabel
    imageStatus.Initialize.BindText(ImageStatusState).Size(12).Color(AppTheme.SecondaryText)

    Dim heroBody As UIColumn
    heroBody.Initialize.Spacing(6dip).AddChild(BuildImageSpace).AddChild(title).AddChild(heading) _
        .AddChild(intro).AddChild(imageStatus)
    HeroCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(20dip).Child(BuildPadding(heroBody, 16dip))

    Dim badge As UICard
    badge.Initialize.BackgroundColor(AppTheme.Accent).CornerRadius(12dip) _
        .Child(BuildPadding(TextLabel("BIRD NOTES", 11, AppTheme.AccentText), 8dip))
    Dim hero As UIStack
    hero.Initialize.Alignment("topRight").AddChild(HeroCard).AddChild(badge)

    Dim varieties As UIButton
    varieties.Initialize.Text("EXPLORE VARIETIES").BackgroundColor(AppTheme.Accent) _
        .TextColor(AppTheme.AccentText).CornerRadius(14dip).OnClick(Me, "OpenVarieties_Click")
    Dim care As UIButton
    care.Initialize.Text("DAILY CARE").BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(14dip).OnClick(Me, "OpenCare_Click")
    Dim actions As UIRow
    actions.Initialize.Spacing(10dip).CrossAxisAlignment("center").AddChild(varieties).AddChild(care)

    Dim overview As UICard = InfoCard("Why canaries?", "They are small, social songbirds. Color, song and temperament vary with the variety and the individual bird.")
    Dim declarativeNote As UICard = InfoCard("What this demo shows", "The app uses a Scaffold, virtual navigation, measured cards, UIState, UIAsyncState, UIAnimation, UIScrollView and UISnackBar in one readable Activity.")

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(hero).AddChild(actions).AddChild(overview).AddChild(declarativeNote)
    Dim scroll As UIScrollView
    scroll.Initialize.Child(BuildPadding(content, 16dip))

    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("CANARY JOURNAL")) _
        .Body(scroll).BottomNavigationBar(BuildNavigation).ApplyTheme(AppTheme)
    Return screen
End Sub

Private Sub BuildVarieties As UIScaffold
    VarietyCards.Initialize
    VarietyImages.Initialize

    Dim title As UILabel = TextLabel("Varieties & colors", 27, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("Three familiar color directions. The bird's health and character matter more than the plumage.", 15, AppTheme.SecondaryText)

    Dim yellow As UICard = ImageCard("Yellow canary", "The classic bright yellow companion, often associated with a clear, lively song.", AppTheme.Accent)
    Dim red As UICard = ImageCard("Red factor", "A warm red-orange variety whose color is supported by the right diet and care.", AppTheme.Negative)
    Dim white As UICard = ImageCard("White canary", "A pale variety that makes a calm, high-contrast subject for a small indoor aviary.", AppTheme.Info)
    VarietyCards.Add(yellow)
    VarietyCards.Add(red)
    VarietyCards.Add(white)

    Dim source As UICard = InfoCard("Image sources", "Photos are loaded from Wikimedia Commons at runtime. The yellow and white images are public domain; the red image is CC BY-SA and should be attributed when reused.")
    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(intro).AddChild(yellow) _
        .AddChild(red).AddChild(white).AddChild(source)

    Dim scroll As UIScrollView
    scroll.Initialize.Child(BuildPadding(content, 16dip))
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("VARIETIES")) _
        .Body(scroll).BottomNavigationBar(BuildNavigation).ApplyTheme(AppTheme)
    Return screen
End Sub

Private Sub BuildCare As UIScaffold
    Dim title As UILabel = TextLabel("Simple daily care", 27, AppTheme.PrimaryText)
    Dim intro As UILabel = TextLabel("A healthy routine is more important than an elaborate cage or a complicated menu.", 15, AppTheme.SecondaryText)

    Dim nameInput As UIInput
    nameInput.Initialize.Hint("Your bird's name").BindText(NameState) _
        .OnTextChanged(Me, "Name_Changed").CornerRadius(12dip).Border(1dip, AppTheme.Border) _
        .ApplyTheme(AppTheme)
    Dim nameCard As UICard
    nameCard.Initialize.CornerRadius(16dip).Child(BuildBox(BuildLabeledInput("Personalize the notes", nameInput), 14dip)) _
        .ApplyTheme(AppTheme)

    Dim tips As UIColumn
    tips.Initialize.Spacing(8dip).AddChild(CareCard("Fresh water", "Replace drinking water daily and clean the container regularly.", AppTheme.Info)) _
        .AddChild(CareCard("Balanced food", "Use a suitable seed mix and ask an avian professional about supplements.", AppTheme.Accent)) _
        .AddChild(CareCard("Light & rest", "Give a predictable day/night rhythm and keep the cage away from drafts.", AppTheme.Negative)) _
        .AddChild(CareCard("Gentle enrichment", "Offer safe perches, room to move and calm interaction without forcing contact.", AppTheme.Accent))

    Dim visibleTips As UIVisibility
    visibleTips.Initialize.BindVisible(TipsVisibleState).OnVisibilityChanged(Me, "Tips_VisibilityChanged").Child(tips)
    Dim toggle As UIButton
    toggle.Initialize.Text(TipsButtonText).BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(12dip).OnClick(Me, "ToggleTips_Click")

    Dim save As UIButton
    save.Initialize.Text("SAVE NOTE").BackgroundColor(AppTheme.Accent).TextColor(AppTheme.AccentText) _
        .CornerRadius(14dip).OnClick(Me, "SaveNote_Click")

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(title).AddChild(intro).AddChild(nameCard) _
        .AddChild(toggle).AddChild(visibleTips).AddChild(save)
    Dim scroll As UIScrollView
    scroll.Initialize.Child(BuildPadding(content, 16dip))
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("DAILY CARE")) _
        .Body(scroll).BottomNavigationBar(BuildNavigation).ApplyTheme(AppTheme)
    Return screen
End Sub

' ============================================================================
' Declarative builders
' ============================================================================

Private Sub BuildUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
        MountVisibleImages
    End If
    Navigator.RefreshInsets
    If ImagesStarted = False Then
        ImagesStarted = True
        LoadCanaryImages
    End If
End Sub

Private Sub GoTo(Route As String)
    ActiveRoute = Route
    Navigator.NavigateTo(Route)
    MountVisibleImages
End Sub

Private Sub BuildBar(Title As String) As UIAppBar
    Dim bar As UIAppBar
    bar.Initialize.Title(Title).ApplyTheme(AppTheme)
    Return bar
End Sub

Private Sub BuildNavigation As UIBottomNavigationBar
    Dim nav As UIBottomNavigationBar
    nav.Initialize.AddItem("Canaries", Chr(61461), "Canaries").AddItem("Varieties", Chr(61502), "Varieties") _
        .AddItem("Care", Chr(61452), "Care").BindSelectedIndex(NavigationState) _
        .OnSelected(Me, "Navigation_Changed").UseFontAwesome(True).ApplyTheme(AppTheme) _
        .IconSize(21).TextSize(10)
    Return nav
End Sub

Private Sub BuildPadding(Child As Object, Amount As Int) As UIPadding
    Dim result As UIPadding
    result.Initialize.All(Amount).Child(Child)
    Return result
End Sub

Private Sub BuildBox(Child As Object, Amount As Int) As UIBox
    Dim result As UIBox
    result.Initialize(Child, Amount)
    Return result
End Sub

Private Sub BuildImageSpace As UISpace
    Dim result As UISpace
    result.Initialize.Size(150dip)
    Return result
End Sub

Private Sub TextLabel(Value As String, Size As Int, Color As Int) As UILabel
    Dim result As UILabel
    result.Initialize.Text(Value).Size(Size).ApplyTheme(AppTheme).Color(Color)
    Return result
End Sub

Private Sub InfoCard(Title As String, Description As String) As UICard
    Dim body As UIColumn
    body.Initialize.Spacing(4dip).AddChild(TextLabel(Title, 16, AppTheme.PrimaryText)) _
        .AddChild(TextLabel(Description, 14, AppTheme.SecondaryText))
    Dim result As UICard
    result.Initialize.CornerRadius(16dip).Child(BuildPadding(body, 14dip)).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub CareCard(Title As String, Description As String, Accent As Int) As UICard
    Dim body As UIColumn
    body.Initialize.Spacing(4dip).AddChild(TextLabel(Title, 16, AppTheme.PrimaryText)) _
        .AddChild(TextLabel(Description, 14, AppTheme.SecondaryText))
    Dim result As UICard
    result.Initialize.BorderColor(Accent).CornerRadius(15dip) _
        .Child(BuildPadding(body, 14dip)).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub ImageCard(Title As String, Description As String, Accent As Int) As UICard
    Dim body As UIColumn
    body.Initialize.Spacing(5dip).AddChild(BuildImageSpace) _
        .AddChild(TextLabel(Title, 17, AppTheme.PrimaryText)) _
        .AddChild(TextLabel(Description, 14, AppTheme.SecondaryText))
    Dim result As UICard
    result.Initialize.BorderColor(Accent).CornerRadius(17dip) _
        .Child(BuildPadding(body, 14dip)).ApplyTheme(AppTheme)
    Return result
End Sub

Private Sub BuildLabeledInput(Caption As String, Input As UIInput) As UIColumn
    Dim result As UIColumn
    result.Initialize.Spacing(5dip).AddChild(TextLabel(Caption, 12, AppTheme.SecondaryText)).AddChild(Input)
    Return result
End Sub

Private Sub TipsButtonText As String
    If ("" & TipsVisibleState.GetState).ToLowerCase = "true" Then Return "HIDE CARE TIPS"
    Return "SHOW CARE TIPS"
End Sub

' ============================================================================
' Remote images and native image bridge
' ============================================================================

Private Sub MountVisibleImages
    If ActiveRoute = "Canaries" Then
        If HeroCard <> Null Then
            Dim heroView As B4XView = HeroCard.GetView
            If heroView <> Null And HeroImage = Null Then
                HeroImage = AddImageView(heroView, 150dip)
                ApplyBitmap(HeroImage, YellowBitmap)
                AnimateHero
            End If
        End If
    Else If ActiveRoute = "Varieties" Then
        If VarietyCards.IsInitialized Then
            If VarietyImages.IsInitialized = False Then VarietyImages.Initialize
            If VarietyImages.Size = 0 Then
                For Each card As UICard In VarietyCards
                    Dim cardView As B4XView = card.GetView
                    If cardView <> Null Then VarietyImages.Add(AddImageView(cardView, 150dip))
                Next
            End If
            If VarietyImages.Size >= 3 Then
                ApplyBitmap(VarietyImages.Get(0), YellowBitmap)
                ApplyBitmap(VarietyImages.Get(1), RedBitmap)
                ApplyBitmap(VarietyImages.Get(2), WhiteBitmap)
            End If
        End If
    End If
End Sub

Private Sub AddImageView(Host As B4XView, Height As Int) As ImageView
    Dim image As ImageView
    image.Initialize("")
    image.Gravity = Gravity.FILL
    image.Color = AppTheme.SurfaceVariant
    Host.AddView(image, 0, 0, Max(0, Host.Width), Height)
    ApplyBitmap(image, FallbackBitmap)
    Return image
End Sub

Private Sub CreateFallbackCanary As Bitmap
    Dim bmp As Bitmap
    bmp.InitializeMutable(900dip, 300dip)
    Dim cvs As Canvas
    cvs.Initialize2(bmp)
    cvs.DrawColor(AppTheme.SurfaceVariant)
    cvs.DrawCircle(450dip, 145dip, 72dip, 0xFFFFD166, True, 0)
    cvs.DrawCircle(415dip, 135dip, 34dip, 0xFFFFE08A, True, 0)
    cvs.DrawCircle(505dip, 128dip, 24dip, 0xFFE9B949, True, 0)
    cvs.DrawCircle(475dip, 118dip, 8dip, 0xFF172033, True, 0)
    cvs.DrawCircle(478dip, 115dip, 3dip, Colors.White, True, 0)
    cvs.DrawLine(520dip, 146dip, 550dip, 155dip, 0xFFE89B2B, 7dip)
    cvs.DrawLine(375dip, 218dip, 535dip, 218dip, 0xFF8B5E3C, 8dip)
    cvs.DrawLine(430dip, 194dip, 420dip, 218dip, 0xFF8B5E3C, 5dip)
    cvs.DrawLine(470dip, 194dip, 480dip, 218dip, 0xFF8B5E3C, 5dip)
    Return bmp
End Sub

Private Sub ApplyBitmap(Target As ImageView, Value As Bitmap)
    If Target = Null Or Value = Null Then Return
    If Target.IsInitialized = False Then Return
    If Value.IsInitialized = False Then Return
    Target.Bitmap = Value
End Sub

Private Sub LoadCanaryImages
    ImageAsyncState.SetLoading
    ImageStatusState.SetState("Loading three reference photos...")

    Dim job As HttpJob
    job.Initialize("", Me)
    job.Download(YellowUrl)
    job.GetRequest.SetHeader("User-Agent", ImageUserAgent)
    Wait For (job) JobDone(job As HttpJob)
    If job.Success Then
        YellowBitmap = job.GetBitmapResize(900dip, 300dip, True)
        ImageStatusState.SetState("Photos loaded from Wikimedia Commons")
    Else
        ImageStatusState.SetState("Some photos could not be loaded")
    End If
    job.Release
    MountVisibleImages

    Dim redJob As HttpJob
    redJob.Initialize("", Me)
    redJob.Download(RedUrl)
    redJob.GetRequest.SetHeader("User-Agent", ImageUserAgent)
    Wait For (redJob) JobDone(redJob As HttpJob)
    If redJob.Success Then RedBitmap = redJob.GetBitmapResize(900dip, 300dip, True)
    redJob.Release
    MountVisibleImages

    Dim whiteJob As HttpJob
    whiteJob.Initialize("", Me)
    whiteJob.Download(WhiteUrl)
    whiteJob.GetRequest.SetHeader("User-Agent", ImageUserAgent)
    Wait For (whiteJob) JobDone(whiteJob As HttpJob)
    If whiteJob.Success Then WhiteBitmap = whiteJob.GetBitmapResize(900dip, 300dip, True)
    whiteJob.Release

    If HasLoadedImage(YellowBitmap) Or HasLoadedImage(RedBitmap) Or HasLoadedImage(WhiteBitmap) Then
        ImageAsyncState.SetSuccess("images")
        ImageStatusState.SetState("Reference photos ready")
    Else
        ImageAsyncState.SetError("No image could be downloaded")
        ImageStatusState.SetState("Photos unavailable; check the network connection")
    End If
    MountVisibleImages
End Sub

Private Sub HasLoadedImage(Value As Bitmap) As Boolean
    If Value = Null Then Return False
    Return Value.IsInitialized
End Sub

Private Sub AnimateHero
    If HeroCard = Null Then Return
    Dim cardView As B4XView = HeroCard.GetView
    If cardView = Null Then Return
    If cardView.IsInitialized = False Then Return
    HeroAnimation.Initialize.TargetView(cardView).MoveTo(cardView.Left, cardView.Top - 5dip) _
        .Duration(140).OnCompleted(Me, "HeroAnimationBack").Start
End Sub

Sub HeroAnimationBack
    If HeroCard = Null Then Return
    Dim cardView As B4XView = HeroCard.GetView
    If cardView = Null Then Return
    HeroAnimation.Initialize.TargetView(cardView).MoveTo(cardView.Left, cardView.Top + 5dip).Duration(180).Start
End Sub

' ============================================================================
' Events
' ============================================================================

Sub Navigation_Changed(Index As Int, Id As String)
    NavigationState.SetState(Index)
    GoTo(Id)
End Sub

Sub OpenVarieties_Click
    NavigationState.SetState(1)
    GoTo("Varieties")
End Sub

Sub OpenCare_Click
    NavigationState.SetState(2)
    GoTo("Care")
End Sub

Sub ToggleTips_Click
    TipsVisibleState.SetState(Not(("" & TipsVisibleState.GetState).ToLowerCase = "true"))
End Sub

Sub Tips_VisibilityChanged(Visibility As UIVisibility)
    If Visibility = Null Then Return
    Navigator.AddScreen("Care", BuildCare)
End Sub

Sub ImageAsyncState_Changed(State As UIAsyncState)
    If State = Null Then Return
    If State.IsLoading Then
        ImageStatusState.SetState("Loading three reference photos...")
    Else If State.IsSuccess Then
        ImageStatusState.SetState("Reference photos ready")
    Else If State.IsError Then
        ImageStatusState.SetState("Photos unavailable; check the network connection")
    End If
End Sub

Sub Name_Changed(NewText As String)
    NameState.SetState(NewText)
End Sub

Sub SaveNote_Click
    Snack.Message("Note saved for " & NameState.GetState).Action("OK", Me, "CloseSnack_Click").Show(Root)
End Sub

Sub CloseSnack_Click
    Snack.Dismiss
End Sub

Sub Activity_Resume
    BuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

' The demo intentionally keeps normal B4A code visible:
' - builders describe the screen tree;
' - UIState updates bound labels and controls;
' - UIScrollView handles measured content;
' - UIAnimation adds one opt-in transition;
' - HttpJob + Wait For loads real images without hiding the platform;
' - UISnackBar provides transient feedback without another Activity.
' ============================================================================
