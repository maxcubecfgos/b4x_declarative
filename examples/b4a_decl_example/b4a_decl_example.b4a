@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Declarative Checkers
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
'    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' One focused game screen. The Activity owns the game state while the
' declarative tree is mounted once and kept alive: gameplay commits only
' the board cells that changed, and every state change is animated with
' the declarative API (UIAnimation with Flutter-style curves).
Sub Process_Globals
    Private Engine As CheckersEngine
    Private StatusState As UIState
    Private ProgressState As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private Screen As UIScaffold
    Private AppTheme As UITheme
    Private Snack As UISnackBar
    Private Dialog As UIAlertDialog
    Private DialogReady As Boolean
    Private StatusCard As UICard
    Private StatusCardReady As Boolean
    Private Board As CheckersBoard
    Private BoardReady As Boolean
    Private ScreenReady As Boolean
    Private InitialLayoutPending As Boolean
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private SelectedRow, SelectedCol As Int
    Private LastFromRow, LastFromCol As Int
    Private LastToRow, LastToCol As Int
    Private HasSelection As Boolean
    Private HasLastMove As Boolean
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If FirstTime Then
        Engine.Initialize
        StatusState.Initialize("Your turn")
        ProgressState.Initialize(0)
        SelectedRow = -1
        SelectedCol = -1
        LastFromRow = -1
        LastFromCol = -1
        LastToRow = -1
        LastToCol = -1
        HasSelection = False
        HasLastMove = False
    End If
    Snack.Initialize
    AppTheme.Initialize.Scheme(0xFF315C8D)
    Root.Color = AppTheme.Background
    ScheduleInitialLayout
End Sub

Private Sub ScheduleInitialLayout
    If InitialLayoutPending Then Return
    InitialLayoutPending = True
    CallSubDelayed(Me, "InitialLayout")
End Sub

Private Sub InitialLayout
    InitialLayoutPending = False
    If Root.Width <= 0 Or Root.Height <= 0 Then
        ScheduleInitialLayout
        Return
    End If
    RebuildUI
End Sub

Private Sub RebuildUI
    If Navigator.IsInitialized Then Navigator.Unmount
    StatusCardReady = False
    BoardReady = False

    Dim appBar As UIAppBar = BuildAppBar
    Dim body As Object = BuildBody
    Dim screen As UIScaffold
    screen.Initialize.AppBar(appBar).Body(body).ApplyTheme(AppTheme)
    Screen = screen
    ScreenReady = True

    Navigator.Initialize.AddScreen("Game", Screen)
    UiMounted = False
    LastWidth = 0
    LastHeight = 0
    MountUI
End Sub

Private Sub MountUI
    If ScreenReady = False Then Return
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
    End If
    Navigator.RefreshInsets
    StatusCardReady = True
    BoardReady = True
    RefreshBoardVisuals
    RevealBoard
End Sub

Private Sub BuildAppBar As UIAppBar
    Dim rules As UIIcon
    rules.Initialize.MaterialCode(0xE88E).Color(AppTheme.DashboardBarText) _
        .OnClick(Me, "Rules_Click").ApplyTheme(AppTheme)

    Dim bar As UIAppBar
    bar.Initialize.Title("Quiet Checkers").Action(rules).ApplyTheme(AppTheme)
    Return bar
End Sub

Private Sub BuildBody As Object
    Dim eyebrow As UILabel
    eyebrow.Initialize.Text("ENGLISH DRAUGHTS").Size(AppTheme.LabelMedium) _
        .Color(AppTheme.Accent).ApplyTheme(AppTheme)

    Dim title As UILabel
    title.Initialize.Text("Your move").Size(AppTheme.TitleLarge) _
        .Color(AppTheme.PrimaryText).ApplyTheme(AppTheme)

    Dim status As UILabel
    status.Initialize.BindText(StatusState).Size(AppTheme.BodyLarge) _
        .Color(AppTheme.SecondaryText).ApplyTheme(AppTheme)

    Dim statusCard As UICard
    statusCard.Initialize.Child(status).ApplyTheme(AppTheme)
    StatusCard = statusCard

    Dim progress As UIProgressBar
    progress.Initialize.BindValue(ProgressState).ApplyTheme(AppTheme)

    Dim board As CheckersBoard
    board.Initialize.OnTap(Me, "Cell_Click").ApplyTheme(AppTheme)
    Board = board

    Dim newGame As UIButton
    newGame.Initialize.Text("NEW GAME").OnClick(Me, "NewGame_Click").ApplyTheme(AppTheme)

    Dim rules As UIButton
    rules.Initialize.Text("HOW TO PLAY").OnClick(Me, "Rules_Click").ApplyTheme(AppTheme)

    Dim actions As UIRow
    actions.Initialize.Spacing(10dip).MainAxisAlignment("center") _
        .CrossAxisAlignment("center").AddChild(newGame).AddChild(rules)

    Dim content As UIColumn
    content.Initialize.Spacing(10dip).CrossAxisAlignment("stretch") _
        .AddChild(eyebrow).AddChild(title).AddChild(statusCard) _
        .AddChild(progress).AddChild(board).AddChild(actions)

    Dim padded As UIBox
    padded.Initialize(content, AppTheme.HorizontalPadding).ApplyTheme(AppTheme)

    Dim scroll As UIScrollView
    scroll.Initialize.Child(padded).ApplyTheme(AppTheme)
    Return scroll
End Sub

Private Sub Cell_Click(Row As Int, Col As Int)
    If Engine.GetWinner <> 0 Then Return
    If Engine.IsHumanTurn = False Then Return

    Dim piece As Int = Engine.GetPiece(Row, Col)
    If piece = 1 Or piece = 2 Then
        ' During a multiple capture only the piece that just jumped may continue.
        If Engine.IsCaptureContinuation And HasSelection _
            And (Row <> SelectedRow Or Col <> SelectedCol) Then
            StatusState.SetState("Continue with the selected piece")
            RefreshBoardVisuals
            Return
        End If
        If HasSelection And Row = SelectedRow And Col = SelectedCol Then Return

        SelectedRow = Row
        SelectedCol = Col
        HasSelection = True
        If Engine.GetLegalMovesForPiece(Row, Col).Size = 0 Then
            If Engine.IsCaptureRequired Then
                StatusState.SetState("Choose a piece that can capture")
            Else
                StatusState.SetState("That piece cannot move")
            End If
        Else If Engine.IsCaptureRequired Then
            StatusState.SetState("Choose a capture destination")
        Else
            StatusState.SetState("Choose a destination")
        End If
        RefreshBoardVisuals
        Board.PulseCell(Row, Col, 4dip)
        Wait For (PulseLegalDestinations) Complete (Result As Boolean)
        Return
    End If

    If HasSelection = False Then Return
    Dim move As Map = FindMove(SelectedRow, SelectedCol, Row, Col)
    If False = move.IsInitialized Then
        StatusState.SetState("That move is not legal")
        Snack.ApplyTheme(AppTheme).Message("That move is not legal").Show(Root)
        RefreshBoardVisuals
        Return
    End If

    Dim fromRow As Int = move.GetDefault("FromRow", -1)
    Dim fromCol As Int = move.GetDefault("FromCol", -1)
    Dim toRow As Int = move.GetDefault("ToRow", -1)
    Dim toCol As Int = move.GetDefault("ToCol", -1)
    Dim capture As Boolean = MoveIsCapture(move)
    Dim midRow As Int = -1
    Dim midCol As Int = -1
    Dim capturedGlyph As String = ""
    Dim capturedColor As Int = 0
    If capture Then
        midRow = (fromRow + toRow) / 2
        midCol = (fromCol + toCol) / 2
        capturedGlyph = PieceGlyph(Engine.GetPiece(midRow, midCol))
        capturedColor = PieceColorFor(midRow, midCol)
    End If
    If Engine.ApplyMove(move) = False Then
        StatusState.SetState("That move is not legal")
        Snack.ApplyTheme(AppTheme).Message("That move is not legal").Show(Root)
        RefreshBoardVisuals
        Return
    End If

    Dim crowned As Boolean = PieceIsKing(toRow, toCol)
    RememberMove(move)
    RefreshBoardVisuals
    If capture Then Board.FadeOutGhost(midRow, midCol, capturedGlyph, capturedColor)
    AnimatePieceMove(fromRow, fromCol, toRow, toCol, crowned)
    If capture Then AnimateCaptureFeedback

    If Engine.IsCaptureContinuation Then
        SelectedRow = toRow
        SelectedCol = toCol
        HasSelection = True
        StatusState.SetState("Continue the capture")
        ProgressState.SetState(0)
        Return
    End If

    HasSelection = False
    StatusState.SetState("Computer is thinking...")
    ProgressState.SetState(35)
    ComputerTurn
End Sub

Private Sub ComputerTurn
    Sleep(220)
    If Engine.GetWinner <> 0 Then
        ShowWinner
        Return
    End If

    Dim computerMove As Map = Engine.PlayComputer(3)
    If False = computerMove.IsInitialized Then
        ShowWinner
        Return
    End If

    Dim fromRow As Int = computerMove.GetDefault("FromRow", -1)
    Dim fromCol As Int = computerMove.GetDefault("FromCol", -1)
    Dim toRow As Int = computerMove.GetDefault("ToRow", -1)
    Dim toCol As Int = computerMove.GetDefault("ToCol", -1)
    Dim capture As Boolean = MoveIsCapture(computerMove)
    Dim midRow As Int = -1
    Dim midCol As Int = -1
    Dim capturedGlyph As String = ""
    Dim capturedColor As Int = 0
    If capture Then
        midRow = (fromRow + toRow) / 2
        midCol = (fromCol + toCol) / 2
        capturedGlyph = PieceGlyph(Engine.GetPiece(midRow, midCol))
        capturedColor = PieceColorFor(midRow, midCol)
    End If
    Dim crowned As Boolean = PieceIsKing(toRow, toCol)

    RememberMove(computerMove)
    ProgressState.SetState(100)
    If Engine.GetWinner = 0 Then
        StatusState.SetState("Your turn")
    Else
        StatusState.SetState(WinnerText)
    End If
    RefreshBoardVisuals
    If capture Then Board.FadeOutGhost(midRow, midCol, capturedGlyph, capturedColor)
    AnimatePieceMove(fromRow, fromCol, toRow, toCol, crowned)
    If capture Then AnimateCaptureFeedback
    Sleep(140)
    ProgressState.SetState(0)
End Sub

' Floats the moved piece over the board, glides it to the destination with
' an easeOutCubic curve and drops a crown pulse when the piece becomes a
' king. Cell taps stay blocked while the glide is in flight.
Private Sub AnimatePieceMove(FromRow As Int, FromCol As Int, ToRow As Int, ToCol As Int, CrownPulse As Boolean)
    If BoardReady = False Then Return
    Board.BeginAnimation
    Board.ShowSpriteAt(FromRow, FromCol, PieceGlyph(Engine.GetPiece(ToRow, ToCol)), PieceColorFor(ToRow, ToCol))
    Board.FadeSpriteIn(70)
    Board.GlideSprite(ToRow, ToCol)
    Wait For (WaitGlide) Complete (Result As Boolean)
    Board.HideSprite
    If CrownPulse Then Board.PulseCell(ToRow, ToCol, 6dip)
    Board.EndAnimation
End Sub

Private Sub WaitGlide As ResumableSub
    Sleep(Board.GlideDuration + 30)
    Return True
End Sub

' Pulses the legal destination cells of the selection, one by one.
Private Sub PulseLegalDestinations As ResumableSub
    If BoardReady = False Then Return True
    Dim legalMoves As List = Engine.GetLegalMoves
    If False = legalMoves.IsInitialized Then Return True
    For Each move As Map In legalMoves
        If SelectedRow = move.GetDefault("FromRow", -1) _
            And SelectedCol = move.GetDefault("FromCol", -1) Then
            Board.PulseCell(move.GetDefault("ToRow", -1), move.GetDefault("ToCol", -1), 3dip)
            Sleep(40)
        End If
    Next
    Return True
End Sub

' Syncs only the board cells whose visual state changed since the last
' commit and re-renders those cells in place, keeping the tree alive.
Private Sub RefreshBoardVisuals
    If BoardReady = False Then Return
    Dim legalMoves As List = Engine.GetLegalMoves
    For row = 0 To 7
        For col = 0 To 7
            Dim selected As Boolean = HasSelection And row = SelectedRow And col = SelectedCol
            Dim lastMove As Boolean = HasLastMove _
                And ((row = LastFromRow And col = LastFromCol) Or (row = LastToRow And col = LastToCol))
            Dim destination As Boolean = HasSelection And IsLegalDestination(legalMoves, row, col)
            Board.SetCell(row, col, PieceGlyph(Engine.GetPiece(row, col)), _
                SquareColorFor(row, col), PieceColorFor(row, col), _
                selected, lastMove, destination)
        Next
    Next
    Board.CommitUpdate
End Sub

Private Sub RevealBoard
    If BoardReady Then Board.Reveal
End Sub

Private Sub IsLegalDestination(Moves As List, Row As Int, Col As Int) As Boolean
    If HasSelection = False Or False = Moves.IsInitialized Then Return False
    For Each move As Map In Moves
        If SelectedRow = move.GetDefault("FromRow", -1) _
            And SelectedCol = move.GetDefault("FromCol", -1) _
            And Row = move.GetDefault("ToRow", -1) _
            And Col = move.GetDefault("ToCol", -1) Then Return True
    Next
    Return False
End Sub

Private Sub FindMove(FromRow As Int, FromCol As Int, ToRow As Int, ToCol As Int) As Map
    For Each move As Map In Engine.GetLegalMovesForPiece(FromRow, FromCol)
        If FromRow = move.GetDefault("FromRow", -1) _
            And FromCol = move.GetDefault("FromCol", -1) _
            And ToRow = move.GetDefault("ToRow", -1) _
            And ToCol = move.GetDefault("ToCol", -1) Then Return move
    Next
    Dim noMove As Map
    Return noMove
End Sub

Private Sub AnimateCaptureFeedback
    If StatusCardReady = False Then Return
    If StatusCard = Null Then Return
    Dim view As B4XView = StatusCard.GetView
    If view = Null Then Return
    If False = view.IsInitialized Or view.Width <= 0 Or view.Height <= 0 Then Return
    Dim originalLeft As Int = view.Left
    Dim originalTop As Int = view.Top
    Dim originalWidth As Int = view.Width
    Dim originalHeight As Int = view.Height
    view.SetLayoutAnimated(0, originalLeft, originalTop + 4dip, originalWidth, originalHeight)
    Dim pulse As UIAnimation
    pulse.Initialize.TargetView(view).MoveAndResize(originalLeft, originalTop, originalWidth, originalHeight + 8dip) _
        .Duration(110).Easing("easeOutCubic").OnCompleted(Me, "CaptureAnimation_Expanded").Start
End Sub

Private Sub CaptureAnimation_Expanded
    If StatusCardReady = False Then Return
    If StatusCard = Null Then Return
    Dim view As B4XView = StatusCard.GetView
    If view = Null Then Return
    If False = view.IsInitialized Then Return
    Dim settle As UIAnimation
    settle.Initialize.TargetView(view).MoveAndResize(view.Left, view.Top - 4dip, view.Width, view.Height - 8dip) _
        .Duration(150).Easing("easeOutCubic").Start
End Sub

Private Sub MoveIsCapture(Move As Map) As Boolean
    If False = Move.IsInitialized Then Return False
    Return ("" & Move.GetDefault("IsCapture", False)).ToLowerCase = "true"
End Sub

Private Sub ShowWinner
    StatusState.SetState(WinnerText)
    Dim dialog As UIAlertDialog
    dialog.Initialize.Title("Game over").Message(WinnerText) _
        .PositiveButton("NEW GAME", Me, "NewGame_Click") _
        .ApplyTheme(AppTheme).Show(Root)
    Dialog = dialog
    DialogReady = True
End Sub

Private Sub Rules_Click
    If DialogReady Then Dialog.Dismiss
    Dim dialog As UIAlertDialog
    dialog.Initialize.Title("How to play") _
        .Message("Move the white pieces diagonally. Captures are mandatory. " _
        & "After a capture, continue with the same piece when another jump is available.") _
        .PositiveButton("GOT IT", Me, "CloseDialog_Click") _
        .ApplyTheme(AppTheme).Show(Root)
    Dialog = dialog
    DialogReady = True
End Sub

Private Sub CloseDialog_Click
    If DialogReady Then Dialog.Dismiss
    DialogReady = False
End Sub

Private Sub NewGame_Click
    If DialogReady Then Dialog.Dismiss
    DialogReady = False
    Engine.ResetGame
    SelectedRow = -1
    SelectedCol = -1
    LastFromRow = -1
    LastFromCol = -1
    LastToRow = -1
    LastToCol = -1
    HasSelection = False
    HasLastMove = False
    StatusState.SetState("Your turn")
    ProgressState.SetState(0)
    RebuildUI
End Sub

Private Sub RememberMove(Move As Map)
    LastFromRow = move.GetDefault("FromRow", -1)
    LastFromCol = move.GetDefault("FromCol", -1)
    LastToRow = move.GetDefault("ToRow", -1)
    LastToCol = move.GetDefault("ToCol", -1)
    HasLastMove = LastFromRow >= 0 And LastFromCol >= 0 _
        And LastToRow >= 0 And LastToCol >= 0
End Sub

Private Sub WinnerText As String
    Select Engine.GetWinner
        Case 1
            Return "You win"
        Case 2
            Return "The computer wins"
        Case 3
            Return "Draw by no progress"
    End Select
    Return "Your turn"
End Sub

Private Sub PieceGlyph(Piece As Int) As String
    Select Piece
        Case 1, 3
            Return "●"
        Case 2, 4
            Return "♛"
    End Select
    Return ""
End Sub

Private Sub PieceColorFor(Row As Int, Col As Int) As Int
    Dim piece As Int = Engine.GetPiece(Row, Col)
    If piece = 1 Or piece = 2 Then Return Colors.White
    If piece = 3 Or piece = 4 Then Return AppTheme.Negative
    If IsDarkSquare(Row, Col) Then Return AppTheme.DashboardBarText
    Return AppTheme.PrimaryText
End Sub

Private Sub SquareColorFor(Row As Int, Col As Int) As Int
    If IsDarkSquare(Row, Col) Then Return AppTheme.SecondaryBar
    Return AppTheme.SurfaceVariant
End Sub

Private Sub IsDarkSquare(Row As Int, Col As Int) As Boolean
    Return (Row + Col) Mod 2 = 1
End Sub

Private Sub PieceIsKing(Row As Int, Col As Int) As Boolean
    Dim piece As Int = Engine.GetPiece(Row, Col)
    Return piece = 2 Or piece = 4
End Sub

Sub Activity_Resume
    If ScreenReady = False Then
        ScheduleInitialLayout
    Else
        MountUI
    End If
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub
