Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=declarativeui
Library3=okhttputils2
Library4=xui
Library5=javaobject
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~AddPermission(android.permission.INTERNET)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=5
NumberOfModules=0
Version=13.7
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Lumen Home
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

Sub Process_Globals
    Private Darkmode As UIState
    Private Devices As List
    Private FilteredDevices As List
    Private DevicesOn As UIState
    Private Energy As UIState
    Private Routines As List
    Private RoutineOn As UIState
    Private RoutineProgress As UIState
    Private Sync As UIAsyncState
    Private SyncLabel As UIState
    Private TitleState As UIState
    Private TabIndex As UIState
    Private SearchStatus As UIState
    Private CurrentTab As String
End Sub

Sub Globals
    Private Root As B4XView
    Private AppTheme As UITheme
    Private Nav As UINavigator
    Private Shell As UIScaffold
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private DevicesList As UIListView
    Private AboutDialog As UIAlertDialog
    Private AddDialog As UIAlertDialog
    Private AddNameInput As UIInput
    Private AddRoomInput As UIInput
End Sub

#Region  Lifecycle

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If FirstTime Then
        Darkmode = UI.State(False)
        Devices = CreateDevices
        FilteredDevices = Devices
        DevicesOn = UI.State("0 of 0 on")
        Energy = UI.State(0)
        Routines = CreateRoutines
        RoutineOn = UI.State("0 of 0 enabled")
        RoutineProgress = UI.State(0)
        Sync = UI.AsyncState
        SyncLabel = UI.State("Tap Sync to refresh device data.")
        TitleState = UI.State("Lumen Home")
        TabIndex = UI.State(0)
        SearchStatus = UI.State(Devices.Size & " devices")
        CurrentTab = ""
        UpdateStats
    End If
    AppTheme = UI.ThemeWithScheme(0xFF4F46E5)
    If ReadBool(Darkmode.GetState) Then AppTheme.DarkMode(True)
    RebuildUI
End Sub

Private Sub RebuildUI
    If Shell.IsInitialized Then UI.Unmount(Shell)

    Nav = UI.Navigator
    Nav.AddScreen("home", HomeScreen)
    Nav.AddScreen("devices", DevicesScreen)
    Nav.AddScreen("routines", RoutinesScreen)
    Nav.AddScreen("settings", SettingsScreen)

    If CurrentTab <> "" Then Nav.NavigateTo(CurrentTab)
    TabIndex.SetState(IndexFor(CurrentTab))

    ' The single ApplyTheme on the scaffold themes the whole tree:
    ' AppBar, BottomNav and FAB receive it directly, and the Navigator
    ' forwards it to every registered screen. Explicit colors always win.
    Shell = UI.Scaffold(Nav) _
        .AppBar(UI.AppBar("").BindTitle(TitleState) _
            .Action(UI.IconFA(Chr(IIf(AppTheme.IsDark, 0xF185, 0xF186))).Size(20) _
                .Color(AppTheme.DashboardBarText).OnClick(Me, "ToggleTheme_Click"))) _
        .BottomNavigationBar(UI.BottomNavigationBar _
            .UseFontAwesome(True) _
            .AddItem("home", Chr(0xF015), "Home") _
            .AddItem("devices", Chr(0xF0E7), "Devices") _
            .AddItem("routines", Chr(0xF017), "Routines") _
            .AddItem("settings", Chr(0xF013), "Settings") _
            .BindSelectedIndex(TabIndex) _
            .OnSelected(Me, "Nav_Selected")) _
        .FloatingActionButtonRight(UI.Fab("+").OnClick(Me, "AddDevice_Click")) _
        .ApplyTheme(AppTheme)

    FilteredDevices = Devices
    SearchStatus.SetState(Devices.Size & " devices")
    UiMounted = False
    LastWidth = 0
    LastHeight = 0
    MountUI
    If CurrentTab <> "" Then TitleState.SetState(TitleFor(CurrentTab))
End Sub

Private Sub MountUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        UI.Show(Root, Shell)
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
    End If
    ' Safe area is measured by the scaffold, not the Navigator.
    Shell.RefreshInsets
End Sub

Sub Activity_Resume
    MountUI
End Sub

#End Region

#Region  Screens

Private Sub HomeScreen As Object
    Dim header As UIColumn = UI.Column(Null).Spacing(2dip) _
        .AddChild(UI.Text(Greeting).Size(24).Color(AppTheme.PrimaryText)) _
        .AddChild(UI.Text("Here's what's happening in your home.").Size(13).Color(AppTheme.SecondaryText))

    Dim hero As UICard = UI.Card(UI.Padding(18dip, UI.Column(Null).Spacing(12dip).CrossAxisAlignment("stretch") _
        .AddChild(UI.Text("Energy today").Size(12).Color(AppTheme.MutedText)) _
        .AddChild(UI.Text("").BindText(Energy).Size(40).Color(AppTheme.Accent)) _
        .AddChild(UI.Progress(0).BarHeight(10dip).CornerRadius(5dip).BindValue(Energy)) _
        .AddChild(UI.Text("estimated from the devices that are on").Size(12).Color(AppTheme.MutedText)))) _
        .CornerRadius(18dip)

    Dim actions As UIRow = UI.Row(Null).Spacing(12dip) _
        .AddChild(UI.Expanded(UI.Button(Chr(0xF144) & "  Run routines").CornerRadius(12dip).OnClick(Me, "GoRoutines_Click"))) _
        .AddChild(UI.Expanded(UI.Button(Chr(0xF067) & "  Add device").CornerRadius(12dip).OnClick(Me, "AddDevice_Click")))

    Dim devicesRow As UIRow = UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Card(UI.Padding(12dip, UI.IconFA(Chr(0xF0E7)).Size(16).Color(Colors.White))) _
            .BackgroundColor(AppTheme.Accent).CornerRadius(20dip)) _
        .AddChild(UI.Expanded(UI.Column(Null).Spacing(2dip) _
            .AddChild(UI.Text("Devices").Size(14).Color(AppTheme.PrimaryText)) _
            .AddChild(UI.Text("").BindText(DevicesOn).Size(12).Color(AppTheme.MutedText)))) _
        .AddChild(UI.IconFA(Chr(0xF105)).Size(18).Color(AppTheme.SecondaryText) _
            .OnClick(Me, "GoDevices_Click"))
    Dim devicesSummary As UICard = UI.Card(UI.Padding(14dip, devicesRow)).CornerRadius(16dip)

    Dim syncRow As UIRow = UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.IconFA(Chr(0xF021)).Size(16).Color(AppTheme.Info)) _
        .AddChild(UI.Expanded(UI.Text("").BindText(SyncLabel).Size(13).Color(AppTheme.SecondaryText))) _
        .AddChild(UI.Button("Sync").CornerRadius(10dip).OnClick(Me, "Sync_Click"))

    Dim content As UIColumn = UI.Column(Null).Spacing(16dip).CrossAxisAlignment("stretch") _
        .AddChild(header) _
        .AddChild(hero) _
        .AddChild(actions) _
        .AddChild(devicesSummary) _
        .AddChild(UI.Card(UI.Padding(14dip, syncRow)))
    Return UI.Scroll(UI.Padding(16dip, content))
End Sub

Private Sub Greeting As String
    Dim ticks As Long = DateTime.Now
    Dim hourOfDay As Int = (ticks / 3600000) Mod 24
    If hourOfDay < 12 Then Return "Good morning"
    If hourOfDay < 18 Then Return "Good afternoon"
    Return "Good evening"
End Sub

Private Sub DevicesScreen As Object
    DevicesList = UI.ListView(FilteredDevices) _
        .ItemHeight(84dip).Overscan(2) _
        .CreateItem(Me, "DeviceItem")

    Dim header As UIRow = UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Text("All devices").Size(20).Color(AppTheme.PrimaryText)) _
        .AddChild(UI.Expanded(UI.Space(1))) _
        .AddChild(UI.Card(UI.Padding(8dip, UI.Text("").BindText(DevicesOn).Size(12).Color(AppTheme.SecondaryText))) _
            .BackgroundColor(AppTheme.Surface).CornerRadius(10dip))

    Dim content As UIColumn = UI.Column(Null).Spacing(10dip).CrossAxisAlignment("stretch") _
        .AddChild(UI.Input("Search by name or room") _
            .OnTextChanged(Me, "DevicesSearch_TextChanged")) _
        .AddChild(UI.Text("").BindText(SearchStatus).Size(12).Color(AppTheme.MutedText)) _
        .AddChild(header) _
        .AddChild(UI.Expanded(DevicesList))
    Return UI.Padding(16dip, content)
End Sub

Sub DeviceItem(Index As Int) As Object
    Dim d As Map = FilteredDevices.Get(Index)
    Dim name As String = d.Get("Name")
    Dim room As String = d.Get("Room")
    Dim glyph As String = d.Get("Glyph")
    Dim badgeColor As Int = d.Get("Color")
    Dim state As UIState = d.Get("On")

    Dim badge As UICard = UI.Card(UI.Padding(12dip, UI.IconFA(glyph).Size(16).Color(Colors.White))) _
        .BackgroundColor(badgeColor).CornerRadius(20dip)
    Dim info As UIColumn = UI.Column(Null).Spacing(2dip) _
        .AddChild(UI.Text(name).Size(15).Color(AppTheme.PrimaryText)) _
        .AddChild(UI.Text(room).Size(12).Color(AppTheme.SecondaryText))
    Return UI.Card(UI.Padding(10dip, UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(badge) _
        .AddChild(UI.Expanded(info)) _
        .AddChild(UI.Switch("").BindChecked(state).OnChanged(Me, "DeviceSwitch_Changed"))))
End Sub

Private Sub RoutinesScreen As Object
    Dim header As UIRow = UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Text("Your routines").Size(20).Color(AppTheme.PrimaryText)) _
        .AddChild(UI.Expanded(UI.Space(1))) _
        .AddChild(UI.Card(UI.Padding(8dip, UI.Text("").BindText(RoutineOn).Size(12).Color(AppTheme.SecondaryText))) _
            .BackgroundColor(AppTheme.Surface).CornerRadius(10dip))

    Dim content As UIColumn = UI.Column(Null).Spacing(12dip).CrossAxisAlignment("stretch") _
        .AddChild(header)
    For Each r As Map In Routines
        content.AddChild(RoutineCard(r))
    Next
    content.AddChild(UI.Progress(0).BarHeight(10dip).CornerRadius(5dip).BindValue(RoutineProgress))
    content.AddChild(UI.Button(Chr(0xF144) & "  Run all routines").CornerRadius(12dip).OnClick(Me, "RunAll_Click"))
    Return UI.Scroll(UI.Padding(16dip, content))
End Sub

Private Sub RoutineCard(R As Map) As UICard
    Dim name As String = R.Get("Name")
    Dim desc As String = R.Get("Desc")
    Dim glyph As String = R.Get("Glyph")
    Dim badgeColor As Int = R.Get("Color")
    Dim state As UIState = R.Get("Enabled")

    Dim badge As UICard = UI.Card(UI.Padding(12dip, UI.IconFA(glyph).Size(16).Color(Colors.White))) _
        .BackgroundColor(badgeColor).CornerRadius(20dip)
    Dim info As UIColumn = UI.Column(Null).Spacing(2dip) _
        .AddChild(UI.Text(name).Size(14).Color(AppTheme.PrimaryText)) _
        .AddChild(UI.Text(desc).Size(11).Color(AppTheme.MutedText))
    Return UI.Card(UI.Padding(10dip, UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(badge) _
        .AddChild(UI.Expanded(info)) _
        .AddChild(UI.Switch("").BindChecked(state).OnChanged(Me, "RoutineSwitch_Changed"))))
End Sub

Private Sub SettingsScreen As Object
    Dim profile As UICard = UI.Card(UI.Padding(14dip, UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Card(UI.Padding(12dip, UI.IconFA(Chr(0xF0EB)).Size(16).Color(Colors.White))) _
            .BackgroundColor(AppTheme.Accent).CornerRadius(20dip)) _
        .AddChild(UI.Expanded(UI.Column(Null).Spacing(2dip) _
            .AddChild(UI.Text("Lumen Home").Size(15).Color(AppTheme.PrimaryText)) _
            .AddChild(UI.Text("Version 1.0.0").Size(12).Color(AppTheme.MutedText)))))) _
        .CornerRadius(16dip)

    Dim darkCard As UICard = UI.Card(UI.Padding(14dip, UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Expanded(UI.Column(Null).Spacing(2dip) _
            .AddChild(UI.Text("Dark mode").Size(14).Color(AppTheme.PrimaryText)) _
            .AddChild(UI.Text("Switch the whole app theme").Size(11).Color(AppTheme.MutedText)))) _
        .AddChild(UI.Switch("").BindChecked(Darkmode).OnChanged(Me, "DarkSwitch_Changed"))))

    Dim aboutCard As UICard = UI.Card(UI.Padding(14dip, UI.Row(Null).Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(UI.Expanded(UI.Column(Null).Spacing(2dip) _
            .AddChild(UI.Text("About").Size(14).Color(AppTheme.PrimaryText)) _
            .AddChild(UI.Text("Built with the DeclarativeUI library").Size(11).Color(AppTheme.MutedText)))) _
        .AddChild(UI.IconFA(Chr(0xF105)).Size(18).Color(AppTheme.SecondaryText) _
            .OnClick(Me, "About_Click"))))

    Dim content As UIColumn = UI.Column(Null).Spacing(12dip).CrossAxisAlignment("stretch") _
        .AddChild(profile) _
        .AddChild(UI.Text("Appearance").Size(12).Color(AppTheme.MutedText)) _
        .AddChild(darkCard) _
        .AddChild(UI.Text("About").Size(12).Color(AppTheme.MutedText)) _
        .AddChild(aboutCard)
    Return UI.Scroll(UI.Padding(16dip, content))
End Sub

#End Region

#Region  Navigation

Sub Nav_Selected(Index As Int, Id As String)
    SwitchTab(Id)
End Sub

Sub GoDevices_Click
    SwitchTab("devices")
End Sub

Sub GoRoutines_Click
    SwitchTab("routines")
End Sub

Private Sub SwitchTab(Id As String)
    CurrentTab = Id
    TabIndex.SetState(IndexFor(Id))
    Nav.NavigateTo(Id)
    TitleState.SetState(TitleFor(Id))
End Sub

Private Sub IndexFor(Id As String) As Int
    Select Id
        Case "home"
            Return 0
        Case "devices"
            Return 1
        Case "routines"
            Return 2
        Case "settings"
            Return 3
    End Select
    Return 0
End Sub

Private Sub TitleFor(Id As String) As String
    Select Id
        Case "home"
            Return "Lumen Home"
        Case "devices"
            Return "Devices"
        Case "routines"
            Return "Routines"
        Case "settings"
            Return "Settings"
    End Select
    Return "Lumen Home"
End Sub

#End Region

#Region  Events

Sub DeviceSwitch_Changed(Checked As Boolean)
    UpdateStats
End Sub

Sub RoutineSwitch_Changed(Checked As Boolean)
    UpdateStats
End Sub

Sub DevicesSearch_TextChanged(Text As String)
    FilteredDevices.Initialize
    Dim q As String = Text.Trim.ToLowerCase
    For Each d As Map In Devices
        Dim name As String = d.Get("Name")
        Dim room As String = d.Get("Room")
        If q.Length = 0 Or name.ToLowerCase.Contains(q) Or room.ToLowerCase.Contains(q) Then
            FilteredDevices.Add(d)
        End If
    Next
    DevicesList.Items(FilteredDevices)
    If FilteredDevices.Size = 0 Then
        SearchStatus.SetState("No devices match " & Chr(34) & q & Chr(34))
    Else If q.Length = 0 Then
        SearchStatus.SetState(Devices.Size & " devices")
    Else
        SearchStatus.SetState(FilteredDevices.Size & " of " & Devices.Size & " match")
    End If
End Sub

Sub DarkSwitch_Changed(Checked As Boolean)
    AppTheme.DarkMode(Checked)
    Darkmode.SetState(Checked)
    RebuildUI
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    Darkmode.SetState(AppTheme.IsDark)
    RebuildUI
End Sub

Sub Sync_Click
    If Sync.IsLoading Then Return
    Sync.SetLoading
    SyncLabel.SetState("Syncing...")
    Sleep(1600)
    Sync.SetSuccess(Null)

    ' Deterministic hub simulation: device state follows the time of day,
    ' so the same sync always reports the same result for a given hour.
    Dim now As Long = DateTime.Now
    Dim hour As Int = DateTime.GetHour(now)
    Dim updated As Int = 0
    For Each d As Map In Devices
        Dim st As UIState = d.Get("On")
        Dim expected As Boolean = HubState(d, hour)
        If ReadBool(st.GetState) <> expected Then
            st.SetState(expected)
            updated = updated + 1
        End If
    Next
    UpdateStats
    SyncLabel.SetState("Last synced " & FormatTime(now) & " - " & updated & " device(s) updated.")
    UI.Snack("Devices synced").Duration(2000).ApplyTheme(AppTheme).Show(Root)
End Sub

Sub RunAll_Click
    RoutineProgress.SetState(0)
    For i = 1 To 10
        Sleep(120)
        RoutineProgress.SetState(i * 10)
    Next
    For Each r As Map In Routines
        ApplyRoutine(r)
    Next
    UpdateStats
    UI.Snack("Routines applied").Duration(2000).ApplyTheme(AppTheme).Show(Root)
End Sub

Sub About_Click
    AboutDialog.Initialize
    AboutDialog.Title("Lumen Home") _
        .Message("A smart-home demo built with the DeclarativeUI library for B4X.") _
        .PositiveButton("Close", Me, "AboutDismiss") _
        .ApplyTheme(AppTheme) _
        .Show(Root)
End Sub

Sub AboutDismiss
    If AboutDialog.IsInitialized Then AboutDialog.Dismiss
End Sub

Sub AddDevice_Click
    AddNameInput = UI.Input("Device name").ApplyTheme(AppTheme)
    AddRoomInput = UI.Input("Room").ApplyTheme(AppTheme)
    AddDialog.Initialize
    AddDialog.Title("Add device") _
        .Content(UI.Column(Null).Spacing(10dip).CrossAxisAlignment("stretch") _
            .AddChild(AddNameInput) _
            .AddChild(AddRoomInput)) _
        .PositiveButton("Add", Me, "AddDeviceConfirm") _
        .NegativeButton("Cancel", Me, "AddDeviceCancel") _
        .ApplyTheme(AppTheme) _
        .Show(Root)
End Sub

Sub AddDeviceConfirm
    Dim newName As String = AddNameInput.GetText.Trim
    If newName.Length = 0 Then
        UI.Snack("A device needs a name").Duration(1800).ApplyTheme(AppTheme).Show(Root)
        Return
    End If
    Dim idx As Int = Devices.Size Mod 4
    Dim color As Int
    Select idx
        Case 0
            color = 0xFFF4B400
        Case 1
            color = 0xFF4285F4
        Case 2
            color = 0xFF34A853
        Case 3
            color = 0xFFDB4437
    End Select
    Devices.Add(NewDevice(newName, AddRoomInput.GetText.Trim, Chr(0xF0EB), color, False))
    FilteredDevices = Devices
    SearchStatus.SetState(Devices.Size & " devices")
    DevicesList.Items(FilteredDevices)
    UpdateStats
    AddDialog.Dismiss
    UI.Snack("Device added").Duration(1500).ApplyTheme(AppTheme).Show(Root)
End Sub

Sub AddDeviceCancel
    If AddDialog.IsInitialized Then AddDialog.Dismiss
End Sub

#End Region

#Region  Data

Private Sub CreateDevices As List
    Dim list As List
    list.Initialize
    list.Add(NewDevice("Living room lamp", "Living room", Chr(0xF0EB), 0xFFF4B400, True))
    list.Add(NewDevice("Bedroom lamp", "Bedroom", Chr(0xF0EB), 0xFFF4B400, False))
    list.Add(NewDevice("Kitchen light", "Kitchen", Chr(0xF0E7), 0xFF4285F4, True))
    list.Add(NewDevice("Coffee maker", "Kitchen", Chr(0xF1E6), 0xFF34A853, False))
    list.Add(NewDevice("Air purifier", "Bedroom", Chr(0xF0E7), 0xFF34A853, False))
    Return list
End Sub

Private Sub NewDevice(Name As String, Room As String, Glyph As String, GlyphColor As Int, IsOn As Boolean) As Map
    Dim m As Map
    m.Initialize
    m.Put("Name", Name)
    m.Put("Room", Room)
    m.Put("Glyph", Glyph)
    m.Put("Color", GlyphColor)
    m.Put("On", UI.State(IsOn))
    Return m
End Sub

Private Sub CreateRoutines As List
    Dim list As List
    list.Initialize
    list.Add(NewRoutine("Morning", "Warm up the kitchen lights", Chr(0xF185), 0xFFF4B400, True))
    list.Add(NewRoutine("Movie night", "Dim the living room", Chr(0xF008), 0xFF4285F4, False))
    list.Add(NewRoutine("Good night", "Turn everything off", Chr(0xF186), 0xFF6750A4, True))
    Return list
End Sub

Private Sub NewRoutine(Name As String, Desc As String, Glyph As String, GlyphColor As Int, IsEnabled As Boolean) As Map
    Dim m As Map
    m.Initialize
    m.Put("Name", Name)
    m.Put("Desc", Desc)
    m.Put("Glyph", Glyph)
    m.Put("Color", GlyphColor)
    m.Put("Enabled", UI.State(IsEnabled))
    Return m
End Sub

Private Sub ApplyRoutine(R As Map)
    Dim routineName As String = R.Get("Name")
    Select routineName
        Case "Morning"
            SetDeviceByName("Kitchen light", True)
            SetDeviceByName("Coffee maker", True)
        Case "Movie night"
            SetDeviceByName("Living room lamp", False)
        Case "Good night"
            For Each d As Map In Devices
                Dim st As UIState = d.Get("On")
                st.SetState(False)
            Next
    End Select
End Sub

Private Sub SetDeviceByName(DeviceName As String, Value As Boolean)
    For Each d As Map In Devices
        If d.Get("Name") = DeviceName Then
            Dim st As UIState = d.Get("On")
            st.SetState(Value)
            Return
        End If
    Next
End Sub

Private Sub UpdateStats
    Dim onCount As Int = 0
    For Each d As Map In Devices
        Dim st As UIState = d.Get("On")
        If ReadBool(st.GetState) Then onCount = onCount + 1
    Next
    DevicesOn.SetState(onCount & " of " & Devices.Size & " on")
    If Devices.Size > 0 Then Energy.SetState(onCount * 100 / Devices.Size)

    Dim onRoutines As Int = 0
    For Each r As Map In Routines
        Dim rs As UIState = r.Get("Enabled")
        If ReadBool(rs.GetState) Then onRoutines = onRoutines + 1
    Next
    RoutineOn.SetState(onRoutines & " of " & Routines.Size & " enabled")
End Sub

Private Sub HubState(Device As Map, Hour As Int) As Boolean
    Dim name As String = Device.Get("Name")
    Select name
        Case "Living room lamp"
            Return Hour >= 18 Or Hour < 7
        Case "Bedroom lamp"
            Return Hour >= 21 Or Hour < 6
        Case "Kitchen light"
            Return Hour >= 7 And Hour < 21
        Case "Coffee maker"
            Return Hour >= 6 And Hour < 9
        Case "Air purifier"
            Return True
    End Select
    Return False
End Sub

Private Sub FormatTime(Ticks As Long) As String
    Dim h As Int = DateTime.GetHour(Ticks)
    Dim m As Int = DateTime.GetMinute(Ticks)
    Return NumberFormat2(h, 0, 0, 2, False) & ":" & NumberFormat2(m, 0, 0, 2, False)
End Sub

Private Sub ReadBool(Value As Object) As Boolean
    If Value = Null Then Return False
    Dim normalized As String = ("" & Value).Trim.ToLowerCase
    If normalized = "true" Then Return True
    If normalized = "false" Or normalized = "" Then Return False
    If IsNumber(normalized) Then
        Dim numericValue As Double = normalized
        Return numericValue <> 0
    End If
    Return False
End Sub

#End Region
