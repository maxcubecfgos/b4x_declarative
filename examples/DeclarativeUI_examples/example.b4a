Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=ime
Library3=xui
Library4=declarativeui
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=13.62
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Declarative UI Demo
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' Pulse is a deliberately small product-style demo rather than a widget gallery.
' One Activity declares three navigable screens with reusable widget builders.

Sub Process_Globals
    Private NavigationState As UIState
    Private CounterState As UIState
    Private ActivityState As UIState
    Private ThemeDetailsState As UIState
    Private ProfileNameState As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private AppTheme As UITheme
    Private ActiveRoute As String
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
    Private HeroCard As UICard
    Private HeroOriginalLeft, HeroOriginalTop As Int
    Private SettingsDetails As UIVisibility
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If NavigationState.IsInitialized = False Then NavigationState.Initialize(0)
    If CounterState.IsInitialized = False Then CounterState.Initialize(0)
    If ActivityState.IsInitialized = False Then ActivityState.Initialize(3)
    If ThemeDetailsState.IsInitialized = False Then ThemeDetailsState.Initialize(False)
    If ProfileNameState.IsInitialized = False Then ProfileNameState.Initialize("Alex")

    AppTheme.Initialize.Scheme(0xFF6750A4)
    ActiveRoute = "Home"
    Navigator.Initialize
    Navigator.AddScreen("Home", BuildHomeScreen)
    Navigator.AddScreen("Activity", BuildActivityScreen)
    Navigator.AddScreen("Settings", BuildSettingsScreen)
    BuildUI
End Sub

' ------------------------------------------------------------------------------
' Screens
' ------------------------------------------------------------------------------

Private Sub BuildHomeScreen As UIScaffold
    Dim greeting As UILabel
    greeting.Initialize.Text("Good morning, Alex").Size(14).Color(AppTheme.SecondaryText)
    Dim headline As UILabel
    headline.Initialize.Text("Keep your momentum.").Size(28).Color(AppTheme.PrimaryText)

    Dim heroTitle As UILabel
    heroTitle.Initialize.Text("TODAY'S PULSE").Size(12).Color(AppTheme.AccentText)
    Dim heroValue As UILabel
    heroValue.Initialize.BindText(CounterState).Size(48).Color(AppTheme.PrimaryText)
    Dim heroCaption As UILabel
    heroCaption.Initialize.Text("small actions, visible progress").Size(14).Color(AppTheme.SecondaryText)
    Dim heroContent As UIColumn
    heroContent.Initialize.Spacing(4dip).AddChild(heroTitle).AddChild(heroValue).AddChild(heroCaption)

    HeroCard.Initialize.BackgroundColor(AppTheme.HeroSurface).BorderColor(AppTheme.Border) _
        .CornerRadius(20dip).Child(BuildPadding(heroContent, 20dip))
    Dim badge As UICard
    badge.Initialize.BackgroundColor(AppTheme.Accent).CornerRadius(14dip) _
        .Child(BuildPadding(Label("LIVE", 12, AppTheme.AccentText), 8dip))
    Dim heroStack As UIStack
    heroStack.Initialize.Alignment("topleft").AddChild(HeroCard).AddChild(BuildBadgeOverlay(badge))

    Dim pulseButton As UIButton
    pulseButton.Initialize.Text("ADD PULSE").BackgroundColor(AppTheme.Accent) _
        .TextColor(AppTheme.AccentText).CornerRadius(14dip).OnClick(Me, "Increment_Click")
    Dim activityButton As UIButton
    activityButton.Initialize.Text("VIEW ACTIVITY").BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(14dip).OnClick(Me, "OpenActivity_Click")

    Dim actionRow As UIRow
    actionRow.Initialize.Spacing(10dip).CrossAxisAlignment("center") _
        .AddChild(pulseButton).AddChild(activityButton)

    Dim metricOne As UICard = BuildMetric("PULSES", CounterState, AppTheme.Accent)
    Dim metricTwo As UICard = BuildMetric("STREAK", ActivityState, AppTheme.Info)
    Dim metricRow As UIRow
    metricRow.Initialize.Spacing(10dip).AddChild(metricOne).AddChild(BuildExpanded(metricTwo))

    Dim content As UIColumn
    content.Initialize.Spacing(12dip).AddChild(greeting).AddChild(headline) _
        .AddChild(heroStack).AddChild(actionRow).AddChild(metricRow) _
        .AddChild(BuildSectionTitle("A calm, declarative UI tree")) _
        .AddChild(BuildInfoCard("State drives the screen", "CounterState updates bound labels without manually finding native views.")) _
        .AddChild(BuildInfoCard("Composition drives layout", "Column, Row, Stack, Padding and Card describe relationships instead of coordinates."))

    Dim scroll As UIScrollView
    scroll.Initialize.Child(content)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("PULSE")) _
        .Body(BuildPadding(scroll, 16dip)).BottomNavigationBar(BuildNavigation) _
        .FloatingActionButtonRight(BuildFab)
    Return screen
End Sub

Private Sub BuildActivityScreen As UIScaffold
    Dim title As UILabel
    title.Initialize.Text("Your activity").Size(26).Color(AppTheme.PrimaryText)
    Dim subtitle As UILabel
    subtitle.Initialize.Text("A scrollable timeline built from the same small set of widgets.").Size(15).Color(AppTheme.SecondaryText)

    Dim activityCount As UILabel
    activityCount.Initialize.BindText(ActivityState).Size(13).Color(AppTheme.AccentText)
    Dim activitySummary As UICard
    activitySummary.Initialize.BackgroundColor(AppTheme.Accent).CornerRadius(14dip) _
        .Child(BuildPadding(BuildSummaryRow("COMPLETED TODAY", activityCount), 12dip))

    Dim list As UIColumn
    list.Initialize.Spacing(10dip).AddChild(title).AddChild(subtitle).AddChild(activitySummary) _
        .AddChild(BuildTimelineCard("08:40", "Morning focus", "You started the day with intention.", AppTheme.Accent)) _
        .AddChild(BuildTimelineCard("11:20", "Deep work", "A quiet block completed successfully.", AppTheme.Info)) _
        .AddChild(BuildTimelineCard("14:05", "Small win", "One more pulse added to your streak.", AppTheme.Negative)) _
        .AddChild(BuildTimelineCard("NOW", "Keep going", "The interface reacts to state, not to boilerplate.", AppTheme.Accent)) _
        .AddChild(BuildInfoCard("UIScrollView", "The content column measures naturally and scrolls inside the scaffold.")) _
        .AddChild(BuildButton("REFRESH ACTIVITY", "RefreshActivity_Click", AppTheme.SurfaceVariant))

    Dim scroll As UIScrollView
    scroll.Initialize.Child(list)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("ACTIVITY")) _
        .Body(BuildPadding(scroll, 16dip)).BottomNavigationBar(BuildNavigation)
    Return screen
End Sub

Private Sub BuildSettingsScreen As UIScaffold
    Dim title As UILabel
    title.Initialize.Text("Personalize Pulse").Size(26).Color(AppTheme.PrimaryText)
    Dim subtitle As UILabel
    subtitle.Initialize.Text("Theme and visibility are state-driven too.").Size(15).Color(AppTheme.SecondaryText)

    Dim profile As UIInput
    profile.Initialize.Hint("Your name").BindText(ProfileNameState) _
        .OnTextChanged(Me, "ProfileName_Changed") _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.PrimaryText).CornerRadius(14dip)

    Dim themeButton As UIButton
    themeButton.Initialize.Text(ThemeButtonText).BackgroundColor(AppTheme.Accent) _
        .TextColor(AppTheme.AccentText).CornerRadius(14dip).OnClick(Me, "ToggleTheme_Click")
    Dim detailsButton As UIButton
    detailsButton.Initialize.Text(DetailsButtonText).BackgroundColor(AppTheme.SurfaceVariant) _
        .TextColor(AppTheme.ButtonText).CornerRadius(14dip).OnClick(Me, "ToggleDetails_Click")

    Dim detailsCard As UIVisibility
    detailsCard.Initialize.BindVisible(ThemeDetailsState).OnVisibilityChanged(Me, "SettingsVisibilityChanged") _
        .Child(BuildInfoCard("UIVisibility", "This section leaves the layout when hidden and returns when shown."))
    SettingsDetails = detailsCard

    Dim form As UIColumn
    form.Initialize.Spacing(12dip).AddChild(title).AddChild(subtitle) _
        .AddChild(BuildLabeledInput("DISPLAY NAME", profile)) _
        .AddChild(BuildInfoCard("UITheme Scheme", "A single seed color derives surfaces, text, borders and accents.")) _
        .AddChild(themeButton).AddChild(detailsButton).AddChild(detailsCard)

    Dim scroll As UIScrollView
    scroll.Initialize.Child(form)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("SETTINGS")) _
        .Body(BuildPadding(scroll, 16dip)).BottomNavigationBar(BuildNavigation)
    Return screen
End Sub

' ------------------------------------------------------------------------------
' Declarative helpers
' ------------------------------------------------------------------------------

Private Sub BuildUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
    End If
    Navigator.RefreshInsets
End Sub

Private Sub RebuildCurrentScreen
    Select Case ActiveRoute
        Case "Home"
            Navigator.AddScreen("Home", BuildHomeScreen)
        Case "Activity"
            Navigator.AddScreen("Activity", BuildActivityScreen)
        Case "Settings"
            Navigator.AddScreen("Settings", BuildSettingsScreen)
    End Select
End Sub

Private Sub GoTo(Route As String)
    ActiveRoute = Route
    Navigator.NavigateTo(Route)
End Sub

Private Sub BuildBar(Title As String) As UIAppBar
    Dim bar As UIAppBar
    bar.Initialize.Title(Title).BackgroundColor(AppTheme.DashboardBar)
    Return bar
End Sub

Private Sub BuildNavigation As UIBottomNavigationBar
    Dim nav As UIBottomNavigationBar
    nav.Initialize.AddItem("Home", "H", "Home").AddItem("Activity", "A", "Activity") _
        .AddItem("Settings", "S", "Settings").BindSelectedIndex(NavigationState) _
        .OnSelected(Me, "Navigation_Changed").BackgroundColor(AppTheme.Surface) _
        .ActiveColor(AppTheme.Accent).InactiveColor(AppTheme.MutedText) _
        .IndicatorColor(AppTheme.Accent).DividerColor(AppTheme.Divider)
    Return nav
End Sub

Private Sub BuildFab As UIFloatingActionButton
    Dim fab As UIFloatingActionButton
    fab.Initialize.Text("+").BackgroundColor(AppTheme.Accent).OnClick(Me, "Increment_Click")
    Return fab
End Sub

Private Sub BuildPadding(Child As Object, Amount As Int) As UIPadding
    Dim padding As UIPadding
    padding.Initialize.All(Amount).Child(Child)
    Return padding
End Sub

Private Sub BuildButton(Text As String, EventName As String, Background As Int) As UIButton
    Dim textColor As Int = AppTheme.ButtonText
    If Background = AppTheme.Accent Then textColor = AppTheme.AccentText
    Dim button As UIButton
    button.Initialize.Text(Text).BackgroundColor(Background).TextColor(textColor) _
        .CornerRadius(14dip).OnClick(Me, EventName)
    Return button
End Sub

Private Sub Label(Text As String, Size As Int, Color As Int) As UILabel
    Dim label As UILabel
    label.Initialize.Text(Text).Size(Size).Color(Color)
    Return label
End Sub

Private Sub BuildSectionTitle(Text As String) As UILabel
    Return Label(Text, 17, AppTheme.PrimaryText)
End Sub

Private Sub BuildInfoCard(Title As String, Description As String) As UICard
    Dim content As UIColumn
    content.Initialize.Spacing(4dip).AddChild(Label(Title, 16, AppTheme.PrimaryText)) _
        .AddChild(Label(Description, 14, AppTheme.SecondaryText))
    Dim card As UICard
    card.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(AppTheme.Border) _
        .CornerRadius(16dip).Child(BuildPadding(content, 14dip))
    Return card
End Sub

Private Sub BuildMetric(Title As String, State As UIState, Accent As Int) As UICard
    Dim metric As UIColumn
    metric.Initialize.Spacing(2dip).AddChild(Label(Title, 12, AppTheme.SecondaryText)) _
        .AddChild(LabelFromState(State, 28, AppTheme.PrimaryText))
    Dim card As UICard
    card.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(Accent).CornerRadius(16dip) _
        .Child(BuildPadding(metric, 14dip))
    Return card
End Sub

Private Sub LabelFromState(State As UIState, Size As Int, Color As Int) As UILabel
    Dim label As UILabel
    label.Initialize.BindText(State).Size(Size).Color(Color)
    Return label
End Sub

Private Sub BuildExpanded(Child As Object) As UIExpanded
    Dim expanded As UIExpanded
    expanded.Initialize.Child(Child)
    Return expanded
End Sub

Private Sub BuildTimelineCard(Time As String, Title As String, Description As String, Accent As Int) As UICard
    Dim timeLabel As UILabel = Label(Time, 12, Accent)
    Dim textColumn As UIColumn
    textColumn.Initialize.Spacing(3dip).AddChild(Label(Title, 16, AppTheme.PrimaryText)) _
        .AddChild(Label(Description, 14, AppTheme.SecondaryText))
    Dim row As UIRow
    row.Initialize.Spacing(12dip).CrossAxisAlignment("center").AddChild(timeLabel).AddChild(BuildExpanded(textColumn))
    Dim card As UICard
    card.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(AppTheme.Border) _
        .CornerRadius(16dip).Child(BuildPadding(row, 14dip))
    Return card
End Sub

Private Sub BuildLabeledInput(Caption As String, Input As UIInput) As UIColumn
    Dim group As UIColumn
    group.Initialize.Spacing(5dip).AddChild(Label(Caption, 12, AppTheme.SecondaryText)).AddChild(Input)
    Return group
End Sub

Private Sub BuildSummaryRow(Caption As String, Value As UILabel) As UIRow
    Dim row As UIRow
    row.Initialize.Spacing(8dip).CrossAxisAlignment("center") _
        .AddChild(Label(Caption, 13, AppTheme.AccentText)).AddChild(BuildExpanded(Value))
    Return row
End Sub

Private Sub BuildBadgeOverlay(Badge As UICard) As UICenter
    Dim center As UICenter
    center.Initialize.Child(Badge)
    Return center
End Sub

' ------------------------------------------------------------------------------
' Events and state
' ------------------------------------------------------------------------------

Sub Navigation_Changed(Index As Int, Id As String)
    If Id.Trim = "" Then Return
    NavigationState.SetState(Index)
    GoTo(Id)
End Sub

Sub OpenActivity_Click
    NavigationState.SetState(1)
    GoTo("Activity")
End Sub

Sub Increment_Click
    Dim value As Int = CounterState.GetState
    CounterState.SetState(value + 1)
    AnimateHero
End Sub

Private Sub AnimateHero
    If HeroCard = Null Then Return
    Dim heroView As B4XView = HeroCard.GetView
    If heroView = Null Then Return
    If heroView.IsInitialized = False Then Return
    HeroOriginalLeft = heroView.Left
    HeroOriginalTop = heroView.Top
    Dim animation As UIAnimation
    animation.Initialize.TargetView(heroView).MoveTo(HeroOriginalLeft, HeroOriginalTop - 8dip) _
        .Duration(130).OnCompleted(Me, "HeroAnimationOut").Start
End Sub

Sub HeroAnimationOut
    If HeroCard = Null Then Return
    Dim heroView As B4XView = HeroCard.GetView
    If heroView = Null Then Return
    Dim animation As UIAnimation
    animation.Initialize.TargetView(heroView).MoveTo(HeroOriginalLeft, HeroOriginalTop).Duration(180).Start
End Sub

Sub RefreshActivity_Click
    Dim value As Int = ActivityState.GetState
    ActivityState.SetState(value + 1)
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    RebuildCurrentScreen
End Sub

Sub ToggleDetails_Click
    ThemeDetailsState.SetState(Not(IsThemeDetailsVisible))
End Sub

Sub SettingsVisibilityChanged(Visibility As UIVisibility)
    RebuildCurrentScreen
End Sub

Private Sub IsThemeDetailsVisible As Boolean
    Return ("" & ThemeDetailsState.GetState).Trim.ToLowerCase = "true"
End Sub

Private Sub ThemeButtonText As String
    If AppTheme.IsDark Then Return "USE LIGHT THEME"
    Return "USE DARK THEME"
End Sub

Private Sub DetailsButtonText As String
    If IsThemeDetailsVisible Then Return "HIDE THEME DETAILS"
    Return "SHOW THEME DETAILS"
End Sub

Sub ProfileName_Changed(NewText As String)
    ProfileNameState.SetState(NewText)
End Sub

Sub Activity_Resume
    BuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

' ==============================================================================
' Why this demo is useful for the forum
' ==============================================================================
' The Activity owns state and event decisions. The screen builders describe the
' UI tree: Scaffold -> AppBar/Body/BottomNavigation/FAB, then Column/Row/Card.
'
' The same counter in traditional B4A would require creating native Panels,
' Labels and Buttons, calculating each bound, attaching click events, preserving
' references and updating the Label manually. Here the bound UILabel reacts to
' CounterState, while UIAnimation handles the visual feedback declaratively.
'
' This is not a claim that the library replaces Flutter. It demonstrates the
' narrower, practical promise: clearer composition, reusable builders and less
' view plumbing for dynamic B4A screens.
' ==============================================================================
