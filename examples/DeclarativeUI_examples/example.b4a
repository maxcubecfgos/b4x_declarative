Build1=Default,b4a.example
Group=Default Group
Library1=core
Library2=ime
Library3=xui
Library4=declarativeui
ManifestCode='This code will be applied to the manifest file during compilation.~\n~'You do not need to modify it in most cases.~\n~'See this link for for more information: https://www.b4x.com/forum/showthread.php?p=78136~\n~AddManifestText(~\n~<uses-sdk android:minSdkVersion="21" android:targetSdkVersion="36"/>~\n~<supports-screens android:largeScreens="true" ~\n~    android:normalScreens="true" ~\n~    android:smallScreens="true" ~\n~    android:anyDensity="true"/>)~\n~SetApplicationAttribute(android:icon, "@drawable/icon")~\n~SetApplicationAttribute(android:label, "$LABEL$")~\n~CreateResourceFromFile(Macro, Themes.LightTheme)~\n~'End of default text.~\n~
NumberOfFiles=0
NumberOfLibraries=4
NumberOfModules=0
Version=13.62
@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: Declarative UI Examples
    #VersionCode: 6
    #VersionName: 3.0
    #SupportedOrientations: portrait
    #EdgeToEdgeOldDevices: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' One Activity, no Starter.bas, no extra modules.
' This file is intentionally compact so the code reduction is visible.

Sub Process_Globals
    Private CounterState As UIState
    Private EmailState As UIState
    Private PasswordState As UIState
    Private LoginStatusState As UIState
    Private RefreshState As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private Navigator As UINavigator
    Private AppTheme As UITheme
    Private ActiveRoute As String
    Private WidgetsDetailsVisible As Boolean
    Private UiMounted As Boolean
    Private LastWidth, LastHeight As Int
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If CounterState.IsInitialized = False Then CounterState.Initialize(0)
    If EmailState.IsInitialized = False Then EmailState.Initialize("")
    If PasswordState.IsInitialized = False Then PasswordState.Initialize("")
    If LoginStatusState.IsInitialized = False Then LoginStatusState.Initialize("No submission yet.")
    If RefreshState.IsInitialized = False Then RefreshState.Initialize(0)
    AppTheme.Initialize.Scheme(0xFF00A896)
    WidgetsDetailsVisible = True
    ActiveRoute = "Catalog"

    Navigator.Initialize
    Navigator.AddScreen("Catalog", BuildCatalogScreen)
    Navigator.AddScreen("Counter", BuildCounterScreen)
    Navigator.AddScreen("Login", BuildLoginScreen)
    Navigator.AddScreen("Widgets", BuildWidgetsScreen)
    BuildUI
End Sub

' The catalog is deliberately small: it introduces the examples without
' duplicating a complete screen implementation for every individual widget.
Private Sub BuildCatalogScreen As UIScaffold
    Dim title As UILabel
    title.Initialize.Text("Declarative UI examples").Size(26).Color(AppTheme.PrimaryText)
    Dim intro As UILabel
    intro.Initialize.Text("One Activity, reusable widget trees, and less native view plumbing.").Size(15).Color(AppTheme.SecondaryText)

    Dim list As UIColumn
    list.Initialize.Spacing(10dip) _
        .AddChild(title) _
        .AddChild(intro) _
        .AddChild(BuildDivider) _
        .AddChild(BuildButton("COUNTER  /  state + FAB", "OpenCounter_Click", AppTheme.Accent)) _
        .AddChild(BuildButton("LOGIN  /  native input", "OpenLogin_Click", AppTheme.SurfaceVariant)) _
        .AddChild(BuildButton("WIDGETS  /  layout + layers + scroll", "OpenWidgets_Click", AppTheme.SurfaceVariant))

    Dim body As UIPadding
    body.Initialize.All(16dip).Child(list)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("DECLARATIVE UI  /  CATALOG")).Body(body)
    Return screen

    ' Imperative B4X would need a Panel, repeated AddView calls, manual vertical
    ' offsets, and click listeners. The list above is the complete catalog tree.
End Sub

' This is the honest reduction example: a counter with state, centering and a FAB.
Private Sub BuildCounterScreen As UIScaffold
    Dim description As UILabel
    description.Initialize.Text("You have pressed the button this many times:").Size(17).Color(AppTheme.SecondaryText)
    Dim value As UILabel
    value.Initialize.BindText(CounterState).Size(52).Color(AppTheme.PrimaryText)
    Dim note As UILabel
    note.Initialize.Text("Only the state changes; the tree stays mounted.").Size(14).Color(AppTheme.MutedText)

    Dim content As UIColumn
    content.Initialize.Spacing(8dip).MainAxisAlignment("center").CrossAxisAlignment("center") _
        .AddChild(description).AddChild(value).AddChild(note)
    Dim center As UICenter
    center.Initialize.Child(content)

    Dim expandedCenter As UIExpanded
    expandedCenter.Initialize.Child(center)
    Dim body As UIColumn
    body.Initialize.Spacing(10dip).AddChild(expandedCenter).AddChild(BuildBackButton)
    Dim screen As UIScaffold
    screen.Initialize _
        .AppBar(BuildBar("COUNTER  /  UIState")) _
        .Body(BuildPadding16(body)) _
        .FloatingActionButtonRight(BuildFab)
    Return screen

    ' Traditional B4X needs native Label/Button references, AddView calls,
    ' coordinate math, safe-area offsets and a manual Text update. This tree
    ' expresses the same screen in about 25 application lines.
End Sub

' The form demonstrates UIInput without introducing a second event language.
Private Sub BuildLoginScreen As UIScaffold
    Dim title As UILabel
    title.Initialize.Text("Welcome back").Size(24).Color(AppTheme.PrimaryText)
    Dim description As UILabel
    description.Initialize.Text("Native EditText controls inside a declarative form.").Size(15).Color(AppTheme.SecondaryText)

    Dim email As UIInput
    email.Initialize.Hint("Email address").BindText(EmailState) _
        .OnTextChanged(Me, "Email_Changed") _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.PrimaryText)
    Dim password As UIInput
    password.Initialize.Hint("Password").BindText(PasswordState) _
        .OnTextChanged(Me, "Password_Changed") _
        .BackgroundColor(AppTheme.SurfaceVariant).TextColor(AppTheme.PrimaryText)

    Dim status As UILabel
    status.Initialize.BindText(LoginStatusState).Size(14).Color(AppTheme.SecondaryText)
    Dim form As UIColumn
    form.Initialize.Spacing(10dip).AddChild(title).AddChild(description) _
        .AddChild(email).AddChild(password) _
        .AddChild(BuildButton("SIGN IN", "SubmitLogin_Click", AppTheme.Accent)) _
        .AddChild(status)

    Dim card As UICard
    card.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(AppTheme.Border) _
        .CornerRadius(16dip).Child(BuildPaddingAmount(form, 18dip))
    Dim body As UIColumn
    body.Initialize.Spacing(10dip).AddChild(card).AddChild(BuildBackButton)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("LOGIN  /  UIInput")).Body(BuildPadding16(body))
    Return screen

    ' Imperative B4X requires two EditTexts, parent panels, bounds, text-change
    ' handlers and teardown code. Here layout and native mounting are delegated;
    ' the Activity keeps only validation and state decisions.
End Sub

' One concise gallery covers the remaining widgets instead of one screen per API.
Private Sub BuildWidgetsScreen As UIScaffold
    Dim heading As UILabel
    heading.Initialize.Text("Composition gallery").Size(24).Color(AppTheme.PrimaryText)
    Dim explanation As UILabel
    explanation.Initialize.Text("Column, Row, Expanded, Card, Stack, Visibility, ScrollView, Space and Divider.").Size(15).Color(AppTheme.SecondaryText)

    Dim row As UIRow
    row.Initialize.Spacing(8dip).CrossAxisAlignment("center") _
        .AddChild(BuildBox("UIBox")) _
        .AddChild(BuildExpandedLabel("UIExpanded")) _
        .AddChild(BuildSpace(8dip))

    Dim layer As UIStack
    layer.Initialize.Alignment("center") _
        .AddChild(BuildCard("UIStack background", "Later children are rendered above earlier children.")) _
        .AddChild(BuildBadge("STACK BADGE"))

    Dim details As UIVisibility
    details.Initialize.Visible(WidgetsDetailsVisible) _
        .Child(BuildCard("UIVisibility", "Hide this child and the Column reflows its siblings."))

    Dim content As UIColumn
    content.Initialize.Spacing(10dip) _
        .AddChild(heading).AddChild(explanation) _
        .AddChild(BuildDivider).AddChild(row).AddChild(layer) _
        .AddChild(details)

    Dim longList As UIColumn
    longList.Initialize.Spacing(8dip) _
        .AddChild(content) _
        .AddChild(BuildCard("UIScrollView", "The parent measures this list and provides a scrollable viewport.")) _
        .AddChild(BuildCard("UITheme", "Toggle the palette without changing the widget API.")) _
        .AddChild(BuildCard("UIState", "Refresh updates a bound label without rebuilding the tree."))
    Dim scroll As UIScrollView
    scroll.Initialize.Child(longList)
    Dim flexible As UIExpanded
    flexible.Initialize.Child(scroll)

    Dim body As UIColumn
    body.Initialize.Spacing(10dip).AddChild(flexible) _
        .AddChild(BuildButton(IIf(WidgetsDetailsVisible, "HIDE DETAILS", "SHOW DETAILS"), "ToggleDetails_Click", AppTheme.Accent)) _
        .AddChild(BuildButton("TOGGLE THEME", "ToggleTheme_Click", AppTheme.ThemeAction)) _
        .AddChild(BuildButton("REFRESH STATE: " & RefreshState.GetState, "Refresh_Click", AppTheme.Info)) _
        .AddChild(BuildBackButton)
    Dim screen As UIScaffold
    screen.Initialize.AppBar(BuildBar("WIDGETS  /  GALLERY")).Body(BuildPadding16(body))
    Return screen

    ' Imperative B4X would manually create a ScrollView and content Panel, set
    ' Panel.Height, calculate z-order, toggle visibility and position each view.
    ' This compact tree demonstrates those relationships without six duplicate
    ' screen implementations or dozens of persistent native view references.
End Sub

Private Sub BuildUI
    If Root.Width <= 0 Or Root.Height <= 0 Then Return
    If UiMounted = False Or LastWidth <> Root.Width Or LastHeight <> Root.Height Then
        Navigator.SetParent(Root)
        Navigator.SetPosition(0, 0)
        Navigator.SetSize(Root.Width, Root.Height)
        Navigator.Render
        UiMounted = True
        LastWidth = Root.Width
        LastHeight = Root.Height
    End If
    Navigator.RefreshInsets
End Sub

Private Sub RebuildCurrentScreen
    Select Case ActiveRoute
        Case "Catalog"
            Navigator.AddScreen("Catalog", BuildCatalogScreen)
        Case "Counter"
            Navigator.AddScreen("Counter", BuildCounterScreen)
        Case "Login"
            Navigator.AddScreen("Login", BuildLoginScreen)
        Case "Widgets"
            Navigator.AddScreen("Widgets", BuildWidgetsScreen)
    End Select
End Sub

Private Sub GoTo(Route As String)
    ActiveRoute = Route
    Navigator.NavigateTo(Route)
End Sub

' Small builders keep screen code readable while still showing the real API.
Private Sub BuildBar(Title As String) As UIAppBar
    Dim bar As UIAppBar
    bar.Initialize.Title(Title).BackgroundColor(AppTheme.SecondaryBar)
    Return bar
End Sub

Private Sub BuildPadding16(Child As Object) As UIPadding
    Return BuildPaddingAmount(Child, 16dip)
End Sub

Private Sub BuildPaddingAmount(Child As Object, Amount As Int) As UIPadding
    Dim padding As UIPadding
    padding.Initialize.All(Amount).Child(Child)
    Return padding
End Sub

Private Sub BuildButton(Text As String, EventName As String, Background As Int) As UIButton
    Dim buttonTextColor As Int = Colors.White
    If Background = AppTheme.SurfaceVariant Then buttonTextColor = AppTheme.ButtonText
    Dim button As UIButton
    button.Initialize.Text(Text).BackgroundColor(Background).TextColor(buttonTextColor).OnClick(Me, EventName)
    Return button
End Sub

Private Sub BuildFab As UIFloatingActionButton
    Dim fab As UIFloatingActionButton
    fab.Initialize.Text("+").BackgroundColor(AppTheme.Accent).OnClick(Me, "Increment_Click")
    Return fab
End Sub

Private Sub BuildBackButton As UIButton
    Return BuildButton("BACK TO EXAMPLES", "BackToCatalog_Click", AppTheme.SurfaceVariant)
End Sub

Private Sub BuildDivider As UIDivider
    Dim divider As UIDivider
    divider.Initialize.Color(AppTheme.Divider)
    Return divider
End Sub

Private Sub BuildSpace(Size As Int) As UISpace
    Dim space As UISpace
    space.Initialize.Size(Size)
    Return space
End Sub

Private Sub BuildBox(Text As String) As UIBox
    Dim label As UILabel
    label.Initialize.Text(Text).Size(15).Color(AppTheme.PrimaryText)
    Dim box As UIBox
    box.Initialize(label, 12dip)
    Return box
End Sub

Private Sub BuildExpandedLabel(Text As String) As UIExpanded
    Dim label As UILabel
    label.Initialize.Text(Text).Size(15).Color(AppTheme.PrimaryText)
    Dim expanded As UIExpanded
    expanded.Initialize.Child(label)
    Return expanded
End Sub

Private Sub BuildCard(Title As String, Description As String) As UICard
    Dim titleLabel As UILabel
    titleLabel.Initialize.Text(Title).Size(17).Color(AppTheme.PrimaryText)
    Dim descriptionLabel As UILabel
    descriptionLabel.Initialize.Text(Description).Size(14).Color(AppTheme.SecondaryText)
    Dim content As UIColumn
    content.Initialize.Spacing(4dip).AddChild(titleLabel).AddChild(descriptionLabel)
    Dim card As UICard
    card.Initialize.BackgroundColor(AppTheme.Surface).BorderColor(AppTheme.Border) _
        .CornerRadius(14dip).Child(BuildPaddingAmount(content, 14dip))
    Return card
End Sub

Private Sub BuildBadge(Text As String) As UICard
    Dim label As UILabel
    label.Initialize.Text(Text).Size(14).Color(Colors.White)
    Dim badge As UICard
    badge.Initialize.BackgroundColor(AppTheme.Accent).CornerRadius(14dip) _
        .Child(BuildPaddingAmount(label, 12dip))
    Return badge
End Sub

Sub OpenCounter_Click
    GoTo("Counter")
End Sub

Sub OpenLogin_Click
    GoTo("Login")
End Sub

Sub OpenWidgets_Click
    GoTo("Widgets")
End Sub

Sub BackToCatalog_Click
    GoTo("Catalog")
End Sub

Sub Increment_Click
    Dim value As Int = CounterState.GetState
    CounterState.SetState(value + 1)
End Sub

Sub Email_Changed(NewText As String)
    EmailState.SetState(NewText)
End Sub

Sub Password_Changed(NewText As String)
    PasswordState.SetState(NewText)
End Sub

Sub SubmitLogin_Click
    Dim email As String = "" & EmailState.GetState
    Dim password As String = "" & PasswordState.GetState
    If email.Trim = "" Or password.Trim = "" Then
        LoginStatusState.SetState("Enter both fields before submitting.")
    Else
        LoginStatusState.SetState("Validation passed. No server call was made.")
    End If
End Sub

Sub ToggleDetails_Click
    WidgetsDetailsVisible = Not(WidgetsDetailsVisible)
    RebuildCurrentScreen
End Sub

Sub Refresh_Click
    Dim value As Int = RefreshState.GetState
    RefreshState.SetState(value + 1)
    RebuildCurrentScreen
End Sub

Sub ToggleTheme_Click
    AppTheme.Toggle
    RebuildCurrentScreen
End Sub

Sub Activity_Resume
    BuildUI
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub

' ==============================================================================
' Honest comparison for the forum
' ==============================================================================
' The counter itself is the reduction proof, not this gallery.
'
' Declarative counter composition:
'
'     content.Initialize.Spacing(8dip).MainAxisAlignment("center") _
'         .AddChild(description).AddChild(value).AddChild(note)
'     screen.Initialize.AppBar(BuildBar("COUNTER / UIState")) _
'         .Body(BuildPadding(content)).FloatingActionButtonRight(BuildFab)
'
' The equivalent imperative version must create native Panels, Labels and a
' Button, calculate safe-area and centered bounds, call AddView repeatedly,
' attach a click event, and update the counter Label after every press.
'
' The gallery has more code because it demonstrates many widgets. It should not
' be presented as a line-count benchmark. The benchmark is the focused counter
' above versus its imperative equivalent.
' ==============================================================================
