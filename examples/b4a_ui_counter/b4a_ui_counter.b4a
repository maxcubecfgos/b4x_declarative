#Region  Project Attributes
    #ApplicationLabel: UI Counter
    #VersionCode: 1
    #VersionName: 1.0
    #SupportedOrientations: portrait
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

' Minimal DeclarativeUI example: a state-bound counter.
' Shows the UI.* factory: no Dim/Initialize/SetParent anywhere.

Sub Process_Globals
    Private State As UIState
End Sub

Sub Globals
    Private Root As B4XView
    Private CounterLabel As UILabel
End Sub

Sub Activity_Create(FirstTime As Boolean)
    Root = Activity
    If FirstTime Then State = UI.State(0)
    BuildAndMount
End Sub

Private Sub BuildAndMount
    CounterLabel = UI.Text("0").Size(64)
    CounterLabel.BindText(State)

    Dim body As UIColumn = UI.Column(Null) _
        .Spacing(24dip).MainAxisAlignment("center").CrossAxisAlignment("center") _
        .AddChild(CounterLabel) _
        .AddChild(UI.Row(Null).Spacing(16dip) _
            .AddChild(UI.Button("Restar").OnClick(Me, "Minus_Click")) _
            .AddChild(UI.Button("Sumar").OnClick(Me, "Plus_Click")))

    UI.Show(Root, UI.Center(body))
End Sub

Sub Plus_Click
    State.SetState(GetCount + 1)
End Sub

Sub Minus_Click
    State.SetState(Max(0, GetCount - 1))
End Sub

Private Sub GetCount As Int
    Return State.GetState
End Sub

Sub Activity_Resume
End Sub

Sub Activity_Pause (UserClosed As Boolean)
End Sub
