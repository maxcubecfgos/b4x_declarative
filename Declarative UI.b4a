@EndOfDesignText@
#Region  Project Attributes 
    #ApplicationLabel: B4A Declarative UI
    #VersionCode: 1
    #VersionName: 
    #SupportedOrientations: unspecified
    #CanInstallToExternalStorage: False
#End Region

#Region  Activity Attributes 
    #FullScreen: False
    #IncludeTitle: False
#End Region

Sub Process_Globals
	Private Counter As Int = 0
	Private CurrentRoute As String = "Dashboard"
End Sub

' --- TODAS las vistas y componentes van aquí ---
Sub Globals
	Private Root As B4XView
    
	' Pantallas
	Private DashboardScreen As UIScaffold
	Private LoginScreen As UIScaffold
    
	' Elementos Dashboard
	Private AppAppBar As UIAppBar
	Private FabDecrement As UIFloatingActionButton
	Private FabIncrement As UIFloatingActionButton
	Private FabNavLogin As UIFloatingActionButton
    
	Private LblTitle As UILabel
	Private LblValue As UILabel
	Private MyDivider As UIDivider
	Private ColumnCardBody As UIColumn
	Private PaddingCard As UIPadding
	Private MainCard As UICard
	Private PaddingScreen As UIPadding
    
	' Elementos Login
	Private LoginBody As UIColumn
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Root = Activity
	Root.Color = 0xFFF5F5F5
    
	' 1. Inicializar Dashboard
	AppAppBar.Initialize.Title("Dashboard").BackgroundColor(0xFF1976D2)
    
	FabDecrement.Initialize.Text("-").BackgroundColor(0xFFFF5252).OnClick(Me, "Decrement_Click")
	FabIncrement.Initialize.Text("+").BackgroundColor(0xFF448AFF).OnClick(Me, "Increment_Click")
    
	' Este botón flota en la esquina superior o donde quieras, pero lo añadimos al Scaffold
	FabNavLogin.Initialize.Text("Login").BackgroundColor(0xFF673AB7).OnClick(Me, "NavigateToLogin")
    
	LblTitle.Initialize.Text("SYSTEM STATUS").Size(14).Color(0xFF607D8B)
	LblValue.Initialize.Size(96).Color(0xFF212121)
	MyDivider.Initialize
    
	ColumnCardBody.Initialize.AddChild(LblTitle).AddChild(MyDivider).AddChild(LblValue)
	PaddingCard.Initialize.All(24dip).Child(ColumnCardBody)
	MainCard.Initialize.BackgroundColor(Colors.White).CornerRadius(16dip).Child(PaddingCard)
	PaddingScreen.Initialize.All(20dip).Child(MainCard)
    
	DashboardScreen.Initialize _
        .AppBar(AppAppBar) _
        .Body(PaddingScreen) _
        .FloatingActionButtonLeft(FabDecrement) _
        .FloatingActionButtonRight(FabIncrement)
        
	' 2. Inicializar Login
	Private LblLogin As UILabel
	LblLogin.Initialize.Text("LOGIN SCREEN").Size(20)
	LoginBody.Initialize.AddChild(LblLogin)
	LoginScreen.Initialize.Body(LoginBody)
    
	BuildUI
End Sub

Sub BuildUI
	Root.RemoveAllViews
    
	If CurrentRoute = "Dashboard" Then
		LblValue.Text("" & Counter)
        
		' --- NUEVO PARADIGMA DE RENDERIZADO ---
		DashboardScreen.SetParent(Root)
		DashboardScreen.SetPosition(0, 0)
		DashboardScreen.SetSize(Root.Width, Root.Height)
		DashboardScreen.Render
        
		' Renderizamos el botón de navegación manualmente si queremos que flote sobre todo
		FabNavLogin.SetParent(Root)
		FabNavLogin.SetPosition(Root.Width - 120dip, 80dip)
		FabNavLogin.SetSize(100dip, 56dip)
		FabNavLogin.Render
        
	Else
        
		' --- NUEVO PARADIGMA DE RENDERIZADO ---
		LoginScreen.SetParent(Root)
		LoginScreen.SetPosition(0, 0)
		LoginScreen.SetSize(Root.Width, Root.Height)
		LoginScreen.Render
        
	End If
End Sub

Sub Increment_Click
	Counter = Counter + 1
	BuildUI
End Sub

Sub Decrement_Click
	Counter = Counter - 1
	BuildUI
End Sub

Sub NavigateToLogin
	CurrentRoute = "Login"
	BuildUI
End Sub