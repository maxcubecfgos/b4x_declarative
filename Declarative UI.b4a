    Private ActivityScroll As UIScrollView
    Private ActivityScrollExpanded As UIExpanded
    Private ActivityCardOne, ActivityCardTwo, ActivityCardThree As UICard
    Private ActivityCardFour, ActivityCardFive, ActivityCardSix As UICard
    Private ActivityOnePadding, ActivityTwoPadding, ActivityThreePadding As UIPadding
    Private ActivityFourPadding, ActivityFivePadding, ActivitySixPadding As UIPadding
    Private ActivityOneBody, ActivityTwoBody, ActivityThreeBody As UIColumn
    Private ActivityFourBody, ActivityFiveBody, ActivitySixBody As UIColumn
