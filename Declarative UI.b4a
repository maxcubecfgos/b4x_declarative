@EndOfDesignText@
#Region  Project Attributes
    #ApplicationLabel: NOVA Control Center
    #VersionCode: 1
    #VersionName: 1.1
    #SupportedOrientations: unspecified
    #CanInstallToExternalStorage: False
#DebuggerForceStandardAssets: True
#End Region

#Region  Activity Attributes
    #FullScreen: False
    #IncludeTitle: False
#End Region

Sub Process_Globals

End Sub

Sub Globals
	Private Root As B4XView
	Private Image As UIImage
	Private TestSwitch As UISwitch
	Private SwitchState As UIState
	Private TestRadioGroup As UIRadioGroup
	Private RadioState As UIState
	Private Content As UIColumn
	Private Center As UICenter
	Private ImageMounted As Boolean
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Root = Activity
	ImageMounted = False
	Image.Initialize.Asset("r.jpg").Width(300dip).Height(220dip).Fit("contain")
	SwitchState.Initialize(False)
	TestSwitch.Initialize.Text("Notifications").BindChecked(SwitchState).OnChanged(Me, "HarnessSwitch_Changed")
	RadioState.Initialize("medium")
	TestRadioGroup.Initialize.Spacing(8dip).AddOption("small", "Small").AddOption("medium", "Medium").AddOption("large", "Large") _
		.BindSelected(RadioState).OnSelected(Me, "HarnessRadio_Selected")
	Content.Initialize.Spacing(16dip).MainAxisAlignment("center").CrossAxisAlignment("center") _
		.AddChild(Image).AddChild(TestSwitch).AddChild(TestRadioGroup)
	Center.Initialize.Child(Content)
	Log("DeclarativeUI TEST INFO  UIImage asset test initialized")
	Log("DeclarativeUI TEST INFO  UISwitch test initialized")
End Sub

Sub Activity_Resume
	If Root.IsInitialized = False Then Return
	If Root.Width <= 0 Or Root.Height <= 0 Then Return
	If ImageMounted Then Return

	Try
		If File.Exists(File.DirAssets, "r.jpg") = False Then
			Log("DeclarativeUI TEST FAIL  UIImage asset -> r.jpg was not packaged in File.DirAssets")
			Return
		End If

		Center.SetParent(Root)
		Center.SetPosition(0, 0)
		Center.SetSize(Root.Width, Root.Height)
		Center.Render

		If Image.IsLoaded = False Then
			Log("DeclarativeUI TEST FAIL  UIImage asset -> r.jpg was not decoded")
		Else
			ImageMounted = True
			Log("DeclarativeUI TEST PASS  UIImage asset render")
		End If

		Dim switchView As B4XView = TestSwitch.GetView
		If switchView = Null Then
			Log("DeclarativeUI TEST FAIL  UISwitch -> native view was not mounted")
		Else If switchView.IsInitialized = False Then
			Log("DeclarativeUI TEST FAIL  UISwitch -> native view was not initialized")
		Else
			SwitchState.SetState(True)
			If TestSwitch.IsChecked Then
				Log("DeclarativeUI TEST PASS  UISwitch render and state binding")
			Else
				Log("DeclarativeUI TEST FAIL  UISwitch -> state binding did not update")
			End If
		End If
	Catch
		Log("DeclarativeUI TEST FAIL  harness -> " & LastException.Message)
	End Try
End Sub

Sub Activity_Pause (UserClosed As Boolean)
	If UserClosed Then
		Center.Unmount
		ImageMounted = False
	End If
End Sub

Private Sub HarnessSwitch_Changed(Checked As Boolean)
	Log("DeclarativeUI TEST INFO  UISwitch changed=" & Checked)
End Sub

Private Sub HarnessRadio_Selected(Value As String)
	Log("DeclarativeUI TEST INFO  UIRadioGroup selected=" & Value)
End Sub
